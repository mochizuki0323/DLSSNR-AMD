                }
            precise float sum = ((den[0] + den[1]) + (den[2] + den[3]))
                              + ((den[4] + den[5]) + (den[6] + den[7]));
            sum = sum + subgroupShuffleXor(sum, 16u);
            const float inv = 1.0 / max(sum, float(NR_SUM_FLOOR));
            NR_FRAG_B pf[4];
            for (int n = 0; n < 4; ++n)
                for (int c = 0; c < 8; ++c)
                    pf[n][c] = NR_E4M3(NR_F16(lg[n][c] * inv));
            for (uint n = 0u; n < 2u; ++n) {
                NR_FRAG_ACC ctx = NR_ACC_ZERO;
                for (uint j = 0u; j < 4u; ++j) {
                    NR_FRAG_A vf;
                    NR_LOAD_A(vf, lds_v, vb + NR_VINDEX(j * 16u, n * 16u), uint(NR_VS));
                    NR_MMA(ctx, vf, pf[j]);
                }
                NR_FRAG_E4M3 result;
#if NR_ATTN_PAIR_QUANT
                for(int c=0;c<8;c+=2) {
                    const fe4m3vec2 q=nr_attn_quant(f16vec2(ctx[c],ctx[c+1]));
                    result[c]=q.x;result[c+1]=q.y;
                }
#else
                for (int c = 0; c < 8; ++c)
                    result[c] = nr_quant_e4m3(NR_F16(ctx[c]));
#endif
#if NR_IMAGE
                if (!nr_tile_oob(i0 / 16u))
                    NR_STORE_ACC_COL(result, act_e4m3,
                        pc.o_off + nr_tile_base(i0 / 16u) + (h * 2u + n) * 256u, 16u);
#else
                NR_STORE_ACC_COL(result, act_e4m3,
                    pc.o_off + (tok0 + i0) * pc.C + h * uint(NR_HD) + n * 16u, pc.C);
#endif
            }
        }
#else
        for (uint i0 = i0beg; i0 < uint(NR_WIN); i0 += i0inc) {
            NR_FRAG_ACC lg[4];
            for (int n = 0; n < 4; ++n) lg[n] = NR_ACC_ZERO;
            // Both layouts contain the same quantized FP8 Q/K values.
#ifndef NR_ABLATE_LOGITS
            for (uint d = 0u; d < uint(NR_HD); d += 16u) {
                NR_QK_A qf;
                NR_LOAD_A(qf, lds_q, qb + i0 * uint(NR_QS) + d, uint(NR_QS));
                for (int n = 0; n < 4; ++n) {
                    NR_QK_B kf;
                    // K as the B operand of q.k^T is K[j][d] read ColumnMajor,
                    // which is exactly [j][d] with stride head_dim.
                    NR_LOAD_B(kf, lds_k, qb + (uint(n) * 16u) * uint(NR_QS) + d, uint(NR_QS));
                    NR_MMA(lg[n], qf, kf);
                    // Legacy diagnostic rounding switch. The production path rounds
                    // the complete biased logit on entry to the half exponential.
#if NR_LOGIT_ACC_F16 == 1
                    for (int c = 0; c < lg[n].length(); ++c)
                        lg[n][c] = nr_round_f16(lg[n][c]);
#elif NR_LOGIT_ACC_F16 == 2
                    // Liveness probe: a rounding this coarse must wreck the
                    // score. If it does not, the loop above was never emitted.
                    for (int c = 0; c < lg[n].length(); ++c)
                        lg[n][c] = floor(lg[n][c]);
#endif
                }
            }
#endif
#if NR_FRAG_EPI
            // ---- the softmax on the fragment, with no staging at all -------
            //
            // The old shape of this was "the only reason it is here rather than
            // in registers is the row reduction" - so the logits went to
            // `lds_s`, a scalar loop over 64 keys read them back on half the
            // lanes, and the whole 8 KB array existed for that. **That array was
            // the kernel's occupancy**: 23552 B of LDS is five workgroups a WGP,
            // and the `NR_LDS_PAD` probe says this kernel is bound by exactly
            // that - 109.5 us at five subgroups a SIMD, 159.2 at three, 214.8 at
            // two, which is a straight 1/occupancy line.
            //
            // `coopmm.glsl` records the map the staging was buying:
            // **component `c` of lane `l` is element `(8*(l/16) + c, l % 16)`**.
            // So the query row and the key of every component are known without
            // memory, the attention bias indexes straight off them, and the row
            // sum is `NR_ACC_ROW_REDUCE` - a sixteen-lane butterfly - because a
            // row is sixteen consecutive lanes at one component.
            {
            const uint arow = 8u * (lane / 16u), acol = lane % 16u;
            float den[8];
            for (int c = 0; c < 8; ++c) den[c] = 0.0;
            for (uint n = 0u; n < 4u; ++n)
                for (int c = 0; c < 8; ++c) {
                    const uint r = i0 + arow + uint(c), j = n * 16u + acol;
                    const float lgt = float(lg[n][c])
#ifdef NR_ABLATE_BIAS
                                            + 0.125;
#else
                                            + wgt_f32[pc.b_off + (h * 64u + r) * 64u + j];
#endif

#ifdef NR_ABLATE_EXP
                    const float ex = lgt;
#else
                    const float ex = nr_fast_exp(lgt);
#endif
                    lg[n][c] = ex;
                    den[c] += ex;
                }
            // The four fragments are summed per column first and the columns
            // across lanes second, where the scalar loop summed all 64 keys in
            // index order. Positive terms, so the reordering is a rounding
            // difference and not a different quantity.
            for (int c = 0; c < 8; ++c) {
                NR_ACC_ROW_REDUCE(den[c]);
                den[c] = 1.0 / max(den[c], float(NR_SUM_FLOOR));
            }
            for (uint n = 0u; n < 4u; ++n) {
                // `NR_F16` first and e4m3 second, which is the double rounding
                // the staged path had - `nr_quant_e4m3` takes an f16 - and not
                // the single f32 -> e4m3 a bare fragment conversion would do.
                for (int c = 0; c < 8; ++c)
                    lg[n][c] = float(NR_F16(float(lg[n][c]) * den[c]));
                NR_FRAG_E4M3 pe = NR_FRAG_E4M3(lg[n]);
                NR_STORE_ACC(pe, lds_p, pb + n * 16u, uint(NR_PS));
            }
            }
            subgroupBarrier();
#else
            for (uint n = 0u; n < 4u; ++n) {
                subgroupBarrier();
                // f16, which is NVIDIA's own logit accumulator type and was
                // measured byte-identical to keeping f32 - see `lds_s`.
                NR_STG_FRAG lf = NR_STG_ACC(lg[n]);
                NR_STORE_ACC(lf, lds_s, sb + n * 16u * uint(NR_SS), uint(NR_SS));
            }
            subgroupBarrier();
            // bias, clamp, exponential, row sum, divide, narrow - all per
            // element, but none of it needs a fragment's own coordinates, so
            // the only reason it is here rather than in registers is the row
            // reduction.
#ifdef NR_ABLATE_SOFTMAX
            for (uint e = lane; e < uint(NR_IROWS * NR_WIN); e += 32u)
                lds_p[pb + e] = nr_quant_e4m3(NR_F16(lds_s[sb + e]));
#else
            for (uint r = lane; r < uint(NR_IROWS); r += 32u) {
                float sum = 0.0;
                for (uint j = 0u; j < uint(NR_WIN); ++j) {
                    const uint slot = (j / 16u) * 16u * uint(NR_SS) + r * uint(NR_SS) + j % 16u;
                    const float lgt = float(lds_s[sb + slot])
#ifdef NR_ABLATE_BIAS
                                            + 0.125;
#else
                                            + wgt_f32[pc.b_off + (h * 64u + i0 + r) * 64u + j];
#endif

    #ifdef NR_ABLATE_EXP
                const float ex = lgt;
#else
                const float ex = nr_fast_exp(lgt);
#endif
                    // Lossless: nr_fast_exp returns the widening of an f16 bit
                    // pattern, so `ex` is already an f16 value.
                    lds_s[sb + slot] = NR_STG(ex);
                    sum += ex;
                }
                const float inv = 1.0 / max(sum, float(NR_SUM_FLOOR));
                for (uint j = 0u; j < uint(NR_WIN); ++j) {
                    const uint slot = (j / 16u) * 16u * uint(NR_SS) + r * uint(NR_SS) + j % 16u;
                    lds_p[pb + r * uint(NR_PS) + j] =
                        nr_quant_e4m3(NR_F16(float(lds_s[sb + slot]) * inv));
                }
            }
#endif
            subgroupBarrier();
#endif   // NR_FRAG_EPI
            // context = P . V, e4m3 both sides, and straight out.
#ifdef NR_ABLATE_CTX
            for (uint e = lane; e < 256u; e += 32u)
                lds_s[sb + (e / 16u) * uint(NR_SS) + e % 16u] = NR_STG(
                    float(lds_p[pb + (e / 64u) * uint(NR_PS) + e % 64u])
                    + float(lds_v[vb + NR_VINDEX(e / uint(NR_HD), e % uint(NR_HD))]));
#endif
            NR_FRAG_ACC ctx[2];
            ctx[0] = NR_ACC_ZERO; ctx[1] = NR_ACC_ZERO;
#ifndef NR_ABLATE_CTX
            for (uint j = 0u; j < uint(NR_WIN); j += 16u) {
                NR_FRAG_A pf;
                NR_LOAD_A(pf, lds_p, pb + j, uint(NR_PS));
                for (uint n = 0u; n < 2u; ++n) {
                    NR_FRAG_B vf;
                    // V is [token][dim] and the context product wants exactly
                    // that, so this one is RowMajor where K's was ColumnMajor.
#if NR_ATTN_VTRANS
                    NR_LOAD_B(vf, lds_v, vb + NR_VINDEX(j, n * 16u), uint(NR_VS));
#else
                    NR_LOAD_B_ROW(vf, lds_v, vb + NR_VINDEX(j, n * 16u), uint(NR_VS));
#endif
                    NR_MMA(ctx[n], pf, vf);
#if NR_ACC_F16 > 0
                    if ((j/16u+1u)%uint(NR_ACC_F16)==0u)
                        for (int z=0; z<ctx[n].length(); ++z)
                            ctx[n][z]=nr_round_f16(float(ctx[n][z]));
#endif
                }
            }
#endif
#if NR_FRAG_EPI
            // The context fragment has the same map as the logit one, so the
            // token and the channel of every component are known and the store
            // reads its value out of a register. The staged form wrote the
            // fragment to `lds_s`, barriered twice and read it back to reach
            // exactly these 256 addresses.
            for (uint n = 0u; n < 2u; ++n)
                for (int c = 0; c < 8; ++c) {
                    const uint t = tok0 + i0 + 8u * (lane / 16u) + uint(c);
                    const uint ch = h * uint(NR_HD) + n * 16u + lane % 16u;
                    const NR_E4M3 val = nr_quant_e4m3(NR_F16(ctx[n][c]));
#if NR_IMAGE
                    if (!nr_tile_oob(i0 / 16u))
                    act_e4m3[pc.o_off + nr_tile_base(i0 / 16u) + (ch / 16u) * 256u
                             + (8u * (lane / 16u) + uint(c)) * 16u + ch % 16u] = val;
#else
                    act_e4m3[pc.o_off + t * pc.C + ch] = val;
#endif
                }
#else
            for (uint n = 0u; n < 2u; ++n) {
                subgroupBarrier();
#ifndef NR_ABLATE_CTX
                // The e4m3 quantiser takes f16, so this narrowing was already
                // in the store below; it has only moved onto the fragment.
                NR_STG_FRAG cf = NR_STG_ACC(ctx[n]);
                NR_STORE_ACC(cf, lds_s, sb, uint(NR_SS));
#endif
                subgroupBarrier();
                for (uint e = lane; e < 256u; e += 32u) {
#ifdef NR_ABLATE_STORE
                    const uint t = tok0 + i0, ch = h * uint(NR_HD) + n * 16u + e;
                    const uint src = sb + e;
#else
                    const uint t = tok0 + i0 + e / 16u;
                    const uint ch = h * uint(NR_HD) + n * 16u + e % 16u;
                    const uint src = sb + (e / 16u) * uint(NR_SS) + e % 16u;
#endif
#ifdef NR_ABLATE_OUT
                    // Same instruction, same count, a footprint that fits in
                    // cache: isolates the cost of *where* this store goes from
                    // the cost of issuing it.
                    act_e4m3[pc.o_off + tid + (ch & 31u)] = nr_quant_e4m3(NR_F16(lds_s[src]));
#else
#if NR_IMAGE
                    // Tile-blocked into this quarter's own tile: slot e/16 of
                    // the tile, channel ch. `i0` is always a multiple of 16 and
                    // e/16 < 16, so the quarter is i0/16 and the slot is e/16.
                    if (!nr_tile_oob(i0 / 16u))
                    act_e4m3[pc.o_off + nr_tile_base(i0 / 16u) + (ch / 16u) * 256u
                             + (e / 16u) * 16u + ch % 16u] =
                        nr_quant_e4m3(NR_F16(lds_s[src]));
#endif
#if NR_IMAGE == 0
                    act_e4m3[pc.o_off + t * pc.C + ch] = nr_quant_e4m3(NR_F16(lds_s[src]));
#endif
#endif
                }
            }
#endif   // NR_FRAG_EPI
        }
#endif // NR_ATTN_TRANSPOSE
        // The next head overwrites the shared Q, K and V, so both waves have to
        // be past their last read of them.
        NR_QKVBAR();
    }
    }
    nr_chain_signal()
    nr_tchain_signal(win)
    NR_OCC_USE(pc.C == 0u, act_f32[0] = 0.0)
    NR_PROF_END(pc.o_off)
}
