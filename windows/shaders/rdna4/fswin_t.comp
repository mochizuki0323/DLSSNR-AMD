#define NR_WARENA      wgt_f16
#define NR_STAGE_T     NR_F16
#define NR_STAGE_FRAG  NR_FRAG_ACC16
#define NR_QPAIR_T     f16vec2
#define NR_QPAIR(v)    nr_requant_pair(v)
