// residual: its PTX (cc_tinlayout_fused_post_block_swin_1h_32, the tail before
// the `sust.p.2d` store) reprojects the previous output through the motion
// texture, reconstructs it with the same five-tap Catmull-Rom the pre block
// uses, and blends it in under a weight the network itself emits:
//
//     w   = clamp( sigmoid(net channel 3) * clamp(param, 0, 1), 0, 1 )
//     rgb = lerp( clamp(0.25 * net.rgb + input), history5tap(uv + mv), w )
//
// where `param` is a device scalar at +104: the model's blend_scale weight
// (0.7397; 1.0 only when absent), which the host puts into [0].w times the
// user's history strength. It is the same shape as the external-mask variant: the scalars travel in the
// buffer at binding 5, and the images move up by one. Production binaries are
// built without this define and are byte-identical to the validated ones.
//
//   [0] = (history and motion are usable, mv scale x, mv scale y, history strength)
//   [1] = (history width, history height, depth present, depth inverted)
layout(set=0,binding=5,std430) readonly buffer NrTemporal { vec4 nr_temporal[3]; };
#if NR_OUT0_NOFORMAT
// The answer image's format comes from its view: the runtime hands the post
// block an image in the frame's own format when the store converts exactly as
// the write-back blit would (the write-back is then a copy); RGBA32F behaves
// as before. Formatless storage writes: Vulkan 1.3 allows them for a format
// with STORAGE_WRITE_WITHOUT_FORMAT, and the runtime checks that bit.
layout(set=0,binding=6) uniform writeonly image2D nr_out0;
#else
layout(set=0,binding=6,rgba32f) uniform writeonly image2D nr_out0;
#endif
layout(set=0,binding=7,rgba32f) uniform writeonly image2D nr_out1;
layout(set=0,binding=8) uniform sampler2D nr_src;
layout(set=0,binding=9) uniform sampler2D nr_motion;
layout(set=0,binding=10) uniform sampler2D nr_history;
#include "temporal_history.glsl"
#else
#if NR_OUT0_NOFORMAT
// The answer image's format comes from its view: the runtime hands the post
// block an image in the frame's own format when the store converts exactly as
// the write-back blit would (the write-back is then a copy); RGBA32F behaves
// as before. Formatless storage writes: Vulkan 1.3 allows them for a format
// with STORAGE_WRITE_WITHOUT_FORMAT, and the runtime checks that bit.
layout(set=0,binding=5) uniform writeonly image2D nr_out0;
#else
layout(set=0,binding=5,rgba32f) uniform writeonly image2D nr_out0;
#endif
layout(set=0,binding=6,rgba32f) uniform writeonly image2D nr_out1;
layout(set=0,binding=7) uniform sampler2D nr_src;
#endif
// ---- NR_IMGOUT_REGS: the RGB projection out of the accumulator -------------
//
// **`image_features` is the whole reason this adapter cannot take the one-wave
// shape**, and it does not have to exist. The array is 64 tokens x 32 channels
// of `NR_F16` = **4096 B**, on top of `lds_k` (2048) and `lds_v` (2048), which
// is the measured 8192 B; at one wave that is 8192 B a *wave* and four
// subgroups a SIMD, against the eight the shipping two-wave shape gets. Delete
// it and one wave is 4096 B a wave - the knee - and the window keeps the -13.5%
// VALU that the token split costs.
//
// It can go because **a token never crosses a wave**. The accumulator's map is
// already relied on twice in this file (the `_ds` pooling epilogue's `px/py`,
// and the fused blend's `slot`): component `c` of lane `l` of the stage-6
// fragment (m, n) is
//
//     token   = tok0 + m*16 + (l % 16)          channel = n*16 + 8*(l/16) + c
//
// so the 32 channels of one token live in exactly two lanes, `l` and `l ^ 16`,
// across the two n fragments. One `v_permlanex16` per component hands a lane
// the eight channels it is missing, and the projection is then a per-lane loop
// over channels 0..31 **in the original's order**, so every f32 sum is the same
// sum in the same sequence. Byte-identical is the acceptance test, not a hope.
//
// Two fragments are paired so no lane computes a token twice: the even `m`
// feeds the low half-wave and the odd `m` the high one, and
// `token = tok0 + 2p*16 + lane` is that pairing for both halves at once. The
// tail is accumulated *inside* the n loop - channels 0..15 when n=0 and 16..31
// when n=1 - which is why the only value carried across is `vec3 o` per pair
// and one f16 accumulator fragment, rather than the whole 64x32 block.
//
// **The pair must travel packed.** Widening the two channels to f32 before the
// select and the shuffle is the same arithmetic on paper and not the same ISA:
// ACO contracts `float(f16) * float(f16)` pairs and stops contracting when the
// sources stop being halves. The picture moved by one code on 0.4% of channel
// samples - `cmp` caught it, a mean would not have. Packed in a uint it is
// byte-identical, and the exchange is one instruction for two channels.
//
// **Measured, and it does not pay. Default off.**
//
//   config                    LDS  VGPR  wv  ins/win  cyc/win   us 1080p  us 4K
//   ship            fw2      8192   192   8     6940     8690      693.0   2839
//   NR_IMGOUT_REGS  fw2      4096   144  10     6406     8184      685.9   2795
//   NR_IMGOUT_REGS  fw1      4096   192   8     5928     7720      692.9   2799
//
// The one-wave shape is reached exactly where the occupancy law puts it - 4096
// B on one wave, 192 VGPRs, eight subgroups a SIMD - and both extents are
// `cmp`-identical to the shipping build. **-11.2% of modelled cycles is -1.4%
// of the dispatch at 4K and 0.0% at 1080p**, and the two-wave variant, which
// keeps the instruction count and only drops the LDS round trip and one
// barrier, measures the same -1.5%. This dispatch is not paying for its
// instructions: `fswin32` matches the WMMA-rate cycle model to 3% and `imagepost32`
// already beats it by 15% at the shipping shape, so cutting instructions only
// takes up slack. Frame A/B, two interleaved passes an extent, byte-identical:
// a wash at both. Do not rebuild this to chase the instruction count - the open
// question is what the ~690 us floor is.
#if NR_IMGOUT_REGS && (NR_MF % 2) != 0
#error "NR_IMGOUT_REGS pairs token fragments: NR_MF must be even (NR_FWAVES 1 or 2)"
#endif
#if !NR_IMGOUT_REGS
// Keep the final half features inside the workgroup instead of writing and
// rereading a complete C32 image. Every token/channel is initialized below.
shared NR_F16 image_features[64*32];
#endif
#endif

// Where the block's 64 tokens come from.
//
//   0  **window-major**: workgroup i reads bytes [i*64*C, (i+1)*64*C). The host
//      gathers the windows, applies the shift, and gathers again for the next
//      layer. This is what every gold score in the corpus was produced with and
//      it is kept because those scores are the only external check there is.
//
//   1  **the kernel addresses the image.** A window is 2x2 tiles of 4x4 pixels
//      and the shift is exactly *one tile*, so window (wx, wy) owns global tiles
//      `(2*wx + sh + q%2, 2*wy + sh + q/2)` for q in 0..3 - no straddling, no
//      per-pixel gather. The output goes back to the tile it came from, which is
//      the cyclic shift's reverse, and since the grid is `ceil(W/8)` and decision
//      1 pads W to a multiple of 16, every tile belongs to exactly one window and
//      nothing is written twice.
//
// **Mode 1 is what a graph runner needs and mode 0 cannot be made into one.**
// Consecutive layers alternate the shift and `_ds` layers halve the resolution,
// so a window-major arena would have to be re-gathered on the host between every
// pair of layers - which is the whole frame's worth of memory traffic, on the
// CPU, 152 times.
#ifndef NR_IMAGE
#define NR_IMAGE 0
#endif

#ifdef NR_FUSED_POST_BLEND
#if !NR_IMAGE || !defined(NR_INPUT_F16) || !defined(NR_FINAL_F16) || NR_C != 32
#error NR_FUSED_POST_BLEND requires the C32 image post kernel
#endif
#endif
// ---- NR_PERSIST: one dispatch for a run of consecutive blocks -------------
//
// **The barrier between two fused-Swin layers of one level is a whole-device
// drain, and the dependency it enforces is not whole-device.** A window reads
// the four tiles it owns, shifted by one tile, so layer i+1's window (wx, wy)
// depends on at most four of layer i's windows and on nothing else. Under
// NR_PERSIST a run of such layers is one dispatch over items `(layer, window)`
// numbered layer-major, **claimed off one atomic counter**, and a consumer
// spins on the four producer flags it actually needs.
//
// Nothing about the arithmetic moves. The body below is the same body, run
// once per claimed item, with `pc` coming out of the weight arena instead of
// the push block and the window coordinate coming out of the item instead of
// `gl_WorkGroupID`.
//
// **It cannot deadlock, and it does not need every workgroup to be resident.**
// Every producer of item n has an index below n, and if the counter has
// reached n then every item below n has already been claimed - by a workgroup
// that is, by definition of having claimed it, running. So a producer is
// either finished or being worked on right now, whatever else the device is
// doing with its WGPs: a compositor or the game's own shaders can hold half
// the machine and the only cost is throughput. (The earlier revision dealt
// item i to workgroup `i % gridDim` statically, which is correct only while
// all of them are launched at once - exactly the assumption a shared GPU
// breaks.) The budget below stays as the last line of defence for a wiring
// bug: a whole-dispatch poll budget per workgroup, so the worst case is one
// timeout's wall time and not one per item - past it every wait returns
// immediately, the error word carries the layer, and the host prints it. A
// wrong picture, bounded in time - never a hang.
//
// The claim is broadcast **through global memory, not LDS**: one `shared uint`
// costs a kilobyte of LDS at the 1 KB allocation granularity, which at C=256
// is 32768 -> 33792 bytes and a workgroup per WGP. Word `[4 + total_windows +
// workgroup]` of the sync region is that broadcast slot, and it costs one
// round trip to L2 per item against a window body of tens of microseconds.
#if NR_PERSIST
#if !NR_IMAGE || NR_DUMP || (defined(NR_POOL_F16) && !NR_PERSIST_DS) || defined(NR_INPUT_F16) \
 || defined(NR_FINAL_F16) || defined(NR_FUSED_POST_BLEND) \
 || defined(NR_FUSED_IMAGE_INPUT) || defined(NR_FUSED_IMAGE_OUTPUT)
#error NR_PERSIST applies to the plain image-mode block only
#endif
#if !NR_COHERENT_ACT
// **The one place in this project that still needs `coherent` on the arena.**
// A persistent dispatch consumes what another *workgroup of the same dispatch*
// produced, so there is no barrier between the two and no invalidate: the only
// statement that reaches is device scope on the access itself.
// `NR_COHERENT_ACT` is off by default for every other kernel - the boundary
// invalidates instead - which would have left this one reading its own L0.
// Build it with `NR_COHERENT_ACT=1`.
#error NR_PERSIST needs NR_COHERENT_ACT=1; a persistent dispatch has no boundary to invalidate at
#endif
// **Re-priced with the boundary invalidate, and it is still a win.** The -2.79% this
// was taken at was measured when every kernel was coherent and device scope on
// these four cost nothing extra. It is not free now - `g_fswinp<C>` are the
// only `scope:SCOPE_DEV` left in the graph and they are ~31% of the frame - and
// it still pays. Two interleaved passes an extent, default against
// `NR_NO_PERSIST=1`:
//
//   1080p   on  7.823 / 7.828 ms @ 2715/2719 MHz   21.24 / 21.28 Mcyc   2.673 J
//           off 8.032 / 8.035    @ 2750/2749       22.09 / 22.09        2.735 J
//   4K      on 28.940 / 28.965   @ 2605/2605       75.39 / 75.44        9.855 J
//           off 29.291 / 29.285  @ 2625/2626       76.89 / 76.90        9.973 J
//
// **-2.6% of time and -2.3% of energy at 1080p, -1.1% and -1.2% at 4K.** Read
// the clock column before the cycle column: the non-persistent graph boosts
// 35 MHz higher at 1080p because its extra barriers leave the card idle, so its
// cycle count overstates the gap by a third. Energy a frame is the invariant
// and it says the same thing.
//
// **The spin's flag load is inside the loop** - the hoisting hazard does not reach
// here. ACO lowers `atomicAdd(nr_sync[idx], 0u)` to a plain
// `buffer_load_b32 ... scope:SCOPE_DEV` (which is the right lowering: the scope
// is what the construct was for), and in `g_fswinp256` that load is the first
// instruction of the loop's own basic block, with both back edges - the budget
// path and the poll path - targeting it. A hoist is impossible here because the
// loop's exit condition is the comparison against its result; the synthetic
// probe that was hoisted had nothing else in the loop to keep it honest.
// Laid out exactly as `PushFSwin` in windows/src/core/nr_graph.cpp - twenty uints,
// two of them read as signed - because the host uploads that struct verbatim.
struct FSwinParams {
    uint x_off, o_off, e_off, ct_off, qkv_off, op_off, b_off,
         rs_off, ars_off, s_off, rsd_off, ard_off, mid_off;
    uint tiles_x, tiles_y;
    int  shift, shift_y;
    uint pool_off, pool_tiles_x, pool_tiles_y;
#ifdef NR_DS_PROJECT
    // NR_PERSIST_DS: the run's last layer may be the level's downsample,
    // whose eleven projection fields come from a table at pcp.ds_off.
    uint ds_w_off, ds_o_off, ds_otx, ds_raster, ds_crow, ds_rows, ds_mode, ds_writer_rows, ds_n;
    uint ds_clear_x, ds_clear_y;
#endif
#ifdef NR_FUSED_UPS_BLEND
    // NR_PERSIST_UPS: PushUps then the projection weights, from pcp.ds_off.
    uint blend_p_off, blend_s_off, blend_o_off, blend_g_off;
    uint blend_tiles_x, blend_tiles_y, blend_itiles_x, blend_itiles_y;
    uint blend_mode, blend_stiles_x;
    uint ups_weight_off;
#endif
};
// Four more the host appends per layer, because **consecutive layers of one
// level do not share a window grid**: the grid is padded per axis for the
// shift, so at C=256 and 1080p it alternates 16x9 and 15x9 every two layers.
// [20] gx, [21] gy, [22] windows, [23] the layer's base in the flag array.
#define NR_PARAM_WORDS 24u
FSwinParams pc;
layout(push_constant) uniform PushPersist {
    uint layers_off;    // u32 index into the weight arena of the record array
    uint sync_off;      // u32 index into the activation arena of the sync region
    uint n_layers, spin_limit;
    uint total_windows; // the item count: the sum of the run's window counts
    uint df_off, df_n0; // NR_PERSIST_DF: dependency tables, ready-at-start count
#if NR_PERSIST_DS || NR_PERSIST_UPS
    uint ds_off;        // u32 index of the DS (last) or UPS (first) layer's 11 fields, 0 = none
#endif
#if NR_TCHAIN
    uint tc_rec;        // nr_chain.glsl record (weight arena u32 index), ~0 = none
#endif
} pcp;
#ifndef NR_PERSIST_DF
#define NR_PERSIST_DF 0
#endif
// [0] the item counter, [1] finished, [2] epoch, [3] error,
// [4 .. 4 + total_windows) the flags, then one broadcast slot per workgroup.
layout(set = 0, binding = 5, std430) coherent buffer Sync { uint nr_sync[]; };
uint nr_wx, nr_wy;
#else
#define nr_wx (gl_WorkGroupID.x)
#define nr_wy (gl_WorkGroupID.y)
layout(push_constant) uniform Push {
    uint x_off, o_off, e_off, ct_off, qkv_off, op_off, b_off,
         rs_off, ars_off, s_off, rsd_off, ard_off,
         mid_off;               // the grouped middle convolution, heads > 1
#if NR_IMAGE
    uint tiles_x, tiles_y;      // the image in 4x4-pixel tiles
    int shift, shift_y;        // signed offsets, in 4-pixel tiles
#if defined(NR_POOL_F16) || defined(NR_FUSED_POST_BLEND) || defined(NR_FUSED_UPS_BLEND)
    uint pool_off, pool_tiles_x, pool_tiles_y;
#elif NR_TCHAIN
    // The host always pushes PushFSwin's twenty words; the record word that
    // follows them has to be at word 20 here too.
    uint nr_tc_pad_pool_off, nr_tc_pad_pool_tiles_x, nr_tc_pad_pool_tiles_y;
#endif
#endif
#ifdef NR_DS_PROJECT
    // The learned [2C][C] downsample projection, fused after the pool.
    // Same fields as gemmds's shear epilogue (gemm1x1.comp, NR_DS_SHEAR).
    uint ds_w_off, ds_o_off, ds_otx, ds_raster, ds_crow, ds_rows, ds_mode, ds_writer_rows, ds_n;
    uint ds_clear_x, ds_clear_y;  // C>=64 real pooled extent; zero outside (gemmds clear_x/y)
#endif
#if defined(NR_FUSED_POST_BLEND) || defined(NR_FUSED_UPS_BLEND)
    uint blend_p_off, blend_s_off, blend_o_off, blend_g_off;
    uint blend_tiles_x, blend_tiles_y, blend_itiles_x, blend_itiles_y;
    uint blend_mode, blend_stiles_x;
#endif
#if defined(NR_FUSED_UPS_PROJECT) || defined(NR_WIDE_UPS_PROJECT)
    uint ups_weight_off;
#endif
#ifdef NR_FUSED_IMAGE_OUTPUT
    uint image_w_off;       // NR_POST_ALPHA: bit 31 restore alpha, bit 30 8-bit rounding
    float image_intensity;
#endif
#ifdef NR_FUSED_IMAGE_INPUT
    uint image_lift_off,image_source_W,image_source_H,image_seed;
    float image_style,image_tone,image_structure,image_skin,image_other,image_noise,image_constant;
#if NR_NOISE_FIELD
    uint image_noise_off;   // u32 index of the precomputed noise features, 0: none
#endif
#endif
#if NR_TCHAIN
    NR_TCHAIN_FIELDS
#endif
} pc;
#endif

// The host pads the window grid for negative per-axis shifts. The PTX
// zero-fills out-of-range input tiles and suppresses their output stores.
// NR_PRE_FULL - CLOSED, keep 0 (no time). A poisoning diagnostic (bit 16) proved
// no out-of-range tile ever occurs in the fused pre-block (3 extents + 5 NVIDIA
// controls). Bit 2 alone moved the controls by up to -1.37 dB only because, with
// the tile branch gone, NIR folded f2f32(f2f16(lift)) and dropped the lift's
// native f16 rounding; bit 64 keeps an opaque branch there and 1|2|4|64 (=71) is
// byte-identical, -574 static instructions - but all scalar/branch: pre 540 us
// either way. The -24 us bit 2 showed was the removed rounding itself. Contract:
// the fused image pre-block's contract. The host selects
// fswinimagepreds32 only for W%8 == H%8 == 0, zero shifts, tiles = extent/4 and
// a W/8 x H/8 window grid (nr_graph.cpp, imgin16wmma fold), and checks
// pool_tiles*2 >= tiles there, so every tile and every pooled pixel is in range:
// the clamps are identities and the out-of-range tests constant false.
#ifndef NR_PRE_FULL
#define NR_PRE_FULL 0
#endif
#if NR_IMAGE
uint nr_tile_base(uint q) {
#if NR_PRE_FULL & 1
    const uint tx=2u*nr_wx+(q&1u), ty=2u*nr_wy+(q>>1);
    return (ty*pc.tiles_x+tx)*uint(NR_C/16)*256u;
#else
    int tx=2*int(nr_wx)+pc.shift+int(q&1u);
    int ty=2*int(nr_wy)+pc.shift_y+int(q>>1);
    tx=clamp(tx,0,int(pc.tiles_x)-1);ty=clamp(ty,0,int(pc.tiles_y)-1);
    return (uint(ty)*pc.tiles_x+uint(tx))*uint(NR_C/16)*256u;
#endif
}
bool nr_tile_oob(uint q) {
#if NR_PRE_FULL & 2
    return false;
#elif NR_ABLATE_OOB
    // Diagnostic only, wrong output at the padded edge of the window grid.
    // Prices the whole out-of-bounds path: the per-component zeroing of the
    // input fragments and the suppressed output stores.
    return false;
#else
    int tx=2*int(nr_wx)+pc.shift+int(q&1u);
    int ty=2*int(nr_wy)+pc.shift_y+int(q>>1);
    return tx<0 || ty<0 || tx>=int(pc.tiles_x) || ty>=int(pc.tiles_y);
#endif
}
#endif

// NR_OOB_SKIP: per-tile skip of out-of-image query tiles in the persistent
// head-split bodies. `nr_mlive[m]` is wave-uniform (it follows the claimed
// item), so every guard is a scalar branch. NR_OOB_SKIP=1 is the guard-cost
// DIAGNOSTIC (wrong output: out-of-image K/V are left uncomputed); 2 is the
// exact path (out-of-image K/V from the layer's cached constant fragments).
#ifndef NR_OOB_SKIP
#define NR_OOB_SKIP 0
#endif
#if NR_OOB_SKIP
#if !(NR_PERSIST && NR_HWAVES && NR_IMAGE)
#error "NR_OOB_SKIP: persistent head-split image bodies only"
#endif
bool nr_mlive[NR_WIN / 16];
#define NR_MG(m) [[dont_flatten]] if (nr_mlive[m])
#else
#define NR_MG(m)
#endif
// NR_OOB_SKIP=3 guards stages 1-2 (the MLP) only; NR_MGA is the guard of the
// attention/projection sites, active only under the diagnostic NR_OOB_SKIP=1.
// NR_MGK marks the K/V epilogues, which that diagnostic also skipped (stale
// LDS K/V, a wrong output); they always run otherwise.
#ifndef NR_EDGE_BODIES
#define NR_EDGE_BODIES 0
#endif
#if NR_EDGE_BODIES && (NR_OOB_SKIP || !NR_IMAGE || NR_WIN != 64 || (!NR_PERSIST && NR_HWAVES) || defined(NR_FUSED_IMAGE_OUTPUT) \
    || (!NR_HWAVES && (NR_HEADS != 1 || NR_FWAVES != 1)))
#error "NR_EDGE_BODIES: persistent head-split or one-wave C=32 image bodies without the fused image output, NR_OOB_SKIP off"
#endif
#if NR_OOB_SKIP == 1
#define NR_MGA(m) NR_MG(m)
#define NR_MGK(m) NR_MG(m)
#define NR_MGJ(j)
#elif NR_EDGE_BODIES
#undef NR_MG
#define NR_MG(m) if ((((NR_LIVE) >> (m)) & 1) != 0)
#define NR_MGA(m) NR_MG(m)
#define NR_MGK(m)
// Key side: an out-of-image key tile's K and V are zero, so its logit MMAs
// leave the zero start and its P.V MMAs add nothing. Measured a tie,
// so off: the skip would also keep a -0.0 context where the MMA makes +0.0.
#ifndef NR_EDGE_KEYS
#define NR_EDGE_KEYS 0
#endif
#if NR_EDGE_KEYS
#define NR_MGJ(j) NR_MG(j)
#else
#define NR_MGJ(j)
#endif
#else
#define NR_MGA(m)
#define NR_MGK(m)
#define NR_MGJ(j)
#endif

#ifdef NR_FUSED_UPS_BLEND
#if !NR_IMAGE || NR_ACC_F16 != 0
#error upsample fusion requires FP32 image path
#endif
#if NR_C == 32
#if NR_HWAVES || !defined(NR_INPUT_F16) || NR_FWAVES != 1
#error C32 upsample fusion requires one wave and FP16 input
#endif
#elif !NR_HWAVES
#error wide upsample fusion requires one wave per head
#endif
#endif
#ifndef NR_UPS_ALIAS
#define NR_UPS_ALIAS 0
#endif
#ifndef NR_UPS_KOUTER
#define NR_UPS_KOUTER 0
#endif
#if NR_UPS_ALIAS && !((NR_HWAVES && defined(NR_WIDE_UPS_PROJECT)) || \
    (!NR_HWAVES && defined(NR_FUSED_UPS_PROJECT) && !NR_K_REGS && !NR_ACTIVATION_LUT && !NR_CONTEXT_LDS))
#error "NR_UPS_ALIAS: head-split wide or one-wave C=32 upsample bodies"
#endif
#ifndef NR_UPS_U32
#define NR_UPS_U32 0
#endif
#if (defined(NR_FUSED_UPS_PROJECT) || defined(NR_WIDE_UPS_PROJECT)) && !NR_UPS_ALIAS
#if NR_UPS_U32
// Windows (LLPC) NR_UPS_U32: the projected pixels as f16 pairs, so the blend reads a pair with
// one ds_load_b32 instead of two ds_load_u16; the fragments are stored in u32 units. Same bytes.
shared uint ups_u32[NR_C*8];
#else
shared NR_F16 ups_projected[NR_C*16];
#endif
#endif
#if NR_UPS_U32
#define NR_UPS_PAIR(pb) unpackFloat2x16(ups_u32[(pb) >> 1u])
#define NR_UPS_ONE(i) unpackFloat2x16(ups_u32[(i) >> 1u])[(i) & 1u]
#if NR_UPS_ALIAS
#define NR_UPS_STORE(frag, off) NR_STORE_ACC_COL(frag, ups_projected, off, 16u)
#else
#define NR_UPS_STORE(frag, off) NR_STORE_ACC_COL(frag, ups_u32, (off) / 2u, 8u)
#endif
#else
#define NR_UPS_PAIR(pb) f16vec2(ups_projected[pb], ups_projected[(pb) + 1u])
#define NR_UPS_ONE(i) ups_projected[i]
#define NR_UPS_STORE(frag, off) NR_STORE_ACC_COL(frag, ups_projected, off, 16u)
#endif

// K as [head][token][dim] so the logit product reads it as a plain RowMajor A,
// and V as [head][dim][token] so the context product does the same. Both are
// written straight from the QKV accumulators, each in the layout its consumer
// wants, with one store apiece.
// **One head at a time**, now 4096 B at every width - the attention is
// independent per head, and staging all of them at once would want 48 KB at
// C=256 and blow decision 12's 32 KB ceiling. The cost is a workgroup barrier
// per head; the QKV projection for a head is computed just before its own
// attention, which also caps the live accumulators at 3*NR_DF rather than 3C/16.
#ifndef NR_ACTIVATION_LUT
#define NR_ACTIVATION_LUT 0
#endif
// Fast profile: four low half-input bits are replaced by their midpoint.
// The 4 KiB FP8 table is embedded in the host and addressed by rsd_off.
#ifndef NR_ACTIVATION_LUT_SHIFT
#define NR_ACTIVATION_LUT_SHIFT 4
#endif
#define NR_ACTIVATION_LUT_SIZE (1u << (16u-NR_ACTIVATION_LUT_SHIFT))
#if NR_HWAVES
// Two exchange buffers, both [token tile][channel fragment][256 B] - the arena's
// own tile-blocked layout, so a fragment is one NR_STORE_ACC_COL out and one
// NR_LOAD_B back, at the same addresses the register form used.
//   lds_x: the window's x, staged once; overwritten in place by stage 2's yq.
//   lds_y: the middle output, then this wave's V, then this wave's context.
// 16 KB each at C=256, and four barriers a window where the token split needs
// sixteen.
#if NR_UPS_ALIAS
// The projected half-resolution pixels are dead once the blend has
// written lds_x (barrier), and lds_y's first write is the middle output two
// barriers later - so they share bytes. At C=256 that is 40960 -> 32768 B of
// LDS, two workgroups a CU instead of one (4 -> 8 waves a SIMD: the 135
// windows fit one pass instead of 2.1). Shared blocks alias at offset 0.
#extension GL_EXT_shared_memory_block : require
shared NrLdsYX { NR_E4M3 lds_y[NR_WIN * NR_C]; NR_E4M3 lds_x[NR_WIN * NR_C]; };
shared NrUpsProj { NR_F16 ups_projected[NR_C * 16]; };
#if NR_UPS_U32
shared NrUpsProjU { uint ups_u32[NR_C * 8]; };   // the same bytes (blocks alias at 0)
#endif
#else
#if NR_PBATCH > 1
shared NR_E4M3 lds_x[NR_PBATCH * NR_WIN * NR_C];
shared NR_E4M3 lds_y[NR_PBATCH * NR_WIN * NR_C];
#else
shared NR_E4M3 lds_x[NR_WIN * NR_C];
shared NR_E4M3 lds_y[NR_WIN * NR_C];
#endif
#endif
#if NR_ACTIVATION_LUT
#define nr_act_lds lds_y
#endif
#else
#if NR_ACTIVATION_LUT && NR_C == 32
#if NR_K_REGS || NR_ATT_F16 || NR_F16_MMA || NR_ACC_F16 != 0
#error "C32 lookup requires the FP32/FP8 shared-memory layout"
#endif
shared NR_E4M3 nr_act_lds[NR_ACTIVATION_LUT_SIZE];
#define lds_k nr_act_lds
#define lds_v nr_act_lds
#define NR_V_LDS_OFFSET 2048u
#else
#define NR_V_LDS_OFFSET 0u
#if NR_UPS_ALIAS
// C=32 one-wave body - the projected pixels (1 KB) die at the blend,
// long before the QKV stage first writes K; one wave, so program order is the
// only ordering LDS needs. 5120 -> 4096 B: six waves a SIMD back to eight.
#extension GL_EXT_shared_memory_block : require
shared NrLdsKV { NR_QK_STAGE_T lds_k[NR_WIN * NR_HD]; NR_PV_STAGE_T lds_v[NR_HD * NR_WIN]; };
shared NrUpsProj { NR_F16 ups_projected[NR_C * 16]; };
#if NR_UPS_U32
shared NrUpsProjU { uint ups_u32[NR_C * 8]; };   // the same bytes (blocks alias at 0)
#endif
#else
#if !NR_K_REGS
// NR_STAGE_T is NR_E4M3, or NR_F16 under NR_F16_MMA - twice the bytes, because
// the operand the logit and context products want is then an f16 fragment. At
// C=32 that is 4096 B here and 4096 in lds_v, 8192 against 4096.
shared NR_QK_STAGE_T lds_k[NR_WIN * NR_HD];
#endif
shared NR_PV_STAGE_T lds_v[NR_HD * NR_WIN];
#endif
#endif
#if NR_CONTEXT_LDS
shared NR_STAGE_T lds_context[NR_WIN * NR_C];
#endif
#endif

// ---- NR_LDS_PAD: an occupancy knob, diagnostic only ----------------------
//
// **Correct output, wrong performance, on purpose.** LDS is allocated per
// workgroup and rounded to the hardware granule, so padding it evicts
// workgroups from the WGP and lowers waves per SIMD without touching a single
// instruction. That is the only way to ask this kernel the question the thread
// trace left open: it issues 76% of cycles across all ports but only ~60% on
// the VALU and ~62% on the matrix pipe, i.e. nothing is saturated and the
// waves are waiting on each other's dependencies. If time is flat as waves per
// SIMD fall, latency hiding is not the limiter and hunting VGPRs down to 128
// for a twelfth wave is worth nothing; if it climbs, the slope prices that
// hunt before anyone starts it.
//
// `spv_stats` prints the resulting Subgroups per SIMD, so the knob's effect is
// checked with no dispatch: NR_LDS_PAD is **bytes**, and only the ones that
// cross a granule do anything.
#ifndef NR_LDS_PAD
#define NR_LDS_PAD 0
#endif
#if NR_LDS_PAD > 0
shared uint nr_lds_pad[NR_LDS_PAD / 4];
#endif

#define NR_TILE(base, row, k, kdim) ((base) + ((row) / 16u) * ((kdim) / 16u) * 256u \
                                   + ((k) / 16u) * 256u)

#if NR_PACK_C32_ACTIVE
#if NR_ACC_F16 != 0 || NR_F16_MMA || NR_WPF
#error "packed C32 weights require FP32 FP8 operands and ordinary loads"
#endif
// Adjacent matrix rows occupy the two halves of one lane's 16-byte record.
// Keeping row selection constant lets the driver combine adjacent reads.
#define NR_C32_WEIGHT(frag,base,row,k,kf) { \
    const uint q=(base)/4u+((row)/2u)*(kf)*128u+(k)*128u+lane*4u+((row)&1u)*2u; \
    NR_WPAIR_FILL(frag,q) }
#else
#define NR_C32_WEIGHT(frag,base,row,k,kf) \
    NR_LOAD_WA(frag,NR_TILE(base,(row)*16u,(k)*16u,(kf)*16u),16u)
#endif

// Adjacent N fragments share one 16-byte lane read. `row` and `k`
// count 16-element fragments; each result keeps its original ascending K
// reduction. The host repacks only weights, before merging persistent runs.
#if (defined(NR_PACKED_QKV) || NR_PACKED_DENSE) && NR_HWAVES
#define NR_WEIGHT_PAIR_S(wf0,wf1,base,row,k,kfrags,bit) { \
    const uint q=(base)/4u + ((row)/2u)*(kfrags)*128u + (k)*128u + lane*4u; \
    NR_WPAIR_FILL2S(wf0,wf1,q,bit) }
#endif

