#define NR_ACCP(x, y)  f16vec2((x), (y))
#else
#define NR_OPA         NR_FRAG_A
#define NR_OPB         NR_FRAG_B
#define NR_ACCF        NR_FRAG_ACC
#define NR_ACCZERO     NR_ACC_ZERO
#define NR_ACC_SCALAR  float
#define NR_WARENA      wgt_e4m3
#define NR_STAGE_T     NR_E4M3
#define NR_STAGE_FRAG  NR_FRAG_E4M3
#define NR_QPAIR_T     fe4m3vec2
