#if NR_TCHAIN
// Tile counters between dispatches (nr_chain.glsl): the decoder's fused
// upsample waits for the lower level's tiles it gathers; a persistent run's
// last layer counts the tiles it wrote.
#define NR_TC_WBIND 4
#include "nr_chain.glsl"
