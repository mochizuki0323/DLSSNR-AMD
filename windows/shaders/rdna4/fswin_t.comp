// ---- NR_F16_MMA: f16 x f16 -> f16 cooperative matrices --------------------
//
// The C=32-class kernels issue ~20 instructions per MMA against NVIDIA's ~10,
// and ~27% of the count is the f32 accumulator: every value leaving it is
// narrowed (`v_cvt_f16_f32`), every quantisation widens it back
// (`v_cvt_f32_f16`), and no epilogue can use packed-f16 math on accumulator
// components. `v_wmma_f16_16x16x16_f16` has an f16 accumulator, so under this
// define the operands become f16 and the epilogues become packed - at half the
// matrix rate (207 against 399 TFLOP/s measured), which at C=32's 29% of the
// FP8 peak leaves the f16 matrix floor well under the measured time.
//
// **The arithmetic the network specifies is unchanged.** Every e4m3 value is
// exact in f16 and the product of two is exact in f16 (8 significant bits <=
// 11), so an f16 WMMA fed with e4m3-valued halves computes the same products.
// Every quantisation point still rounds to the e4m3 grid - through
// `nr_requant_pair` in coopmm.glsl - the value simply continues as an f16
// instead of an e4m3 byte. The **final store** to the activation arena is
// still e4m3: the arena's format is the interface between layers.
//
// What moves: the weights come from the f16 arena (binding 4, tile-blocked the
// same way, 2 bytes an element, so the push offsets are half-indices), K and V
// stage through LDS as f16 (8192 B at C=32 against 4096), and the k-step
// accumulation rounds in f16 rather than f32.
//
// Default off, and the NR_F16_MMA=0 SPIR-V is byte-identical.
#ifndef NR_F16_MMA
#define NR_F16_MMA 0
#endif
#if NR_F16_MMA
#if NR_HEADS != 1
#error "NR_F16_MMA is the one-head path only (NR_HEADS=1)"
#endif
#if NR_HWAVES || NR_PERSIST || NR_ACC_F16 != 0 || NR_DUMP || NR_K_REGS
#error "NR_F16_MMA needs NR_HWAVES=0, NR_PERSIST=0, NR_ACC_F16=0, NR_DUMP=0"
#endif
#if defined(NR_INPUT_F16) || defined(NR_POOL_F16) || defined(NR_FINAL_F16) \
 || defined(NR_FUSED_IMAGE_INPUT) || defined(NR_FUSED_IMAGE_OUTPUT) \
 || defined(NR_FUSED_POST_BLEND)
#error "NR_F16_MMA does not support the fused image / post variants"
#endif
#if NR_NORM_F32
// The whole point of the f16 accumulator in the Q/K norm is that
// `f16vec2(qkv[d][c], qkv[NR_DF+d][c])` is a free pack rather than two
// `v_cvt_f16_f32`; the f32 reduction squares out of an accumulator that no
// longer holds f32. Build with NR_NORM_F32=0.
#error "NR_F16_MMA needs the packed-half Q/K norm: build with NR_NORM_F32=0"
#endif
#if !NR_QUANT_PAIRED
#error "NR_F16_MMA needs the paired quantiser: NR_QUANT_MODE 4 or 5"
#endif
#if NR_ACT_F32
#error "NR_F16_MMA has no f32 accumulator for NR_ACT_F32's f32 activation"
#endif
#if !NR_PTX_ACC || !NR_NATIVE_RESIDUAL || !NR_PACKED_SWIN_MATH || !NR_ACT_PACKED
#error "NR_F16_MMA implements the shipping packed paths only"
#endif
#endif

