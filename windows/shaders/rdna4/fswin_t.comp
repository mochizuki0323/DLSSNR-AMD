// NR_TCHAIN with NR_DS_PROJECT: the downsample store's pooled 4x4 block at
// ((2wx+shift)*2, (2wy+shift_y)*2), clipped the way the store clips it (grid,
// raster, output tiles, writer rows; the identity shear only - the host chains
// nothing else), as a range of next-level tiles. Lane q < 4 names corner tile
// (tx0 + q&1, ty0 + q>>1) when it is in the range; the host counts the same.
#define NR_TC_DS_TILE(nr_q, nr_out) { \
    const int nr_px0 = (2 * int(nr_wx) + pc.shift) * 2, nr_py0 = (2 * int(nr_wy) + pc.shift_y) * 2; \
    const uint nr_wr = pc.ds_writer_rows == 0u ? pc.ds_rows : pc.ds_writer_rows; \
    const int nr_lx = min(min(int(pc.pool_tiles_x * 4u), int(pc.ds_raster)), int(pc.ds_otx * 4u)) - 1; \
    const int nr_ly = min(int(pc.pool_tiles_y * 4u), int(nr_wr)) - 1; \
    const int nr_x0 = max(nr_px0, 0), nr_x1 = min(nr_px0 + 3, nr_lx); \
    const int nr_y0 = max(nr_py0, 0), nr_y1 = min(nr_py0 + 3, nr_ly); \
    const int nr_tx = nr_x0 / 4 + int((nr_q) & 1u), nr_ty = nr_y0 / 4 + int((nr_q) >> 1u); \
    nr_out = (nr_x0 <= nr_x1 && nr_y0 <= nr_y1 && nr_tx <= nr_x1 / 4 && nr_ty <= nr_y1 / 4) \
        ? uint(nr_ty) * pc.ds_otx + uint(nr_tx) : 0xFFFFFFFFu; }

