#if NR_ACT_HORNER
float nr_act_horner(float x) {
    const float t=clamp(x,-4.0,4.0);
    const float u=fma(-0.055908203125,abs(t),0.447265625);
    return x*fma(t,u,0.89453125);
}
#define nr_mp_cubic_silu nr_act_horner
// NR_ACT_ALT: the second value of each pair spells the same Horner steps
// with the multiplicands swapped (bit-identical: IEEE fma/mul commute), so the
// register allocator sees different killed operands for adjacent values and
// can meet VOPD's even/odd destination rule more often. 1 both, 2 mul, 3 fma.
#ifndef NR_ACT_ALT
#define NR_ACT_ALT 0
#endif
// Modes 1-3 as before; 4..11 are the bit set (mode-4): bit0 swaps u's fma,
// bit1 w's fma, bit2 the final mul (4 = none, 11 = all).
#if NR_ACT_ALT >= 4
#define NR_ALT_U (((NR_ACT_ALT - 4) & 1) != 0)
#define NR_ALT_W (((NR_ACT_ALT - 4) & 2) != 0)
#define NR_ALT_M (((NR_ACT_ALT - 4) & 4) != 0)
#else
#define NR_ALT_U (NR_ACT_ALT == 1 || NR_ACT_ALT == 3)
#define NR_ALT_W (NR_ACT_ALT == 1 || NR_ACT_ALT == 3)
#define NR_ALT_M (NR_ACT_ALT == 1 || NR_ACT_ALT == 2)
#endif
float nr_act_horner_b(float x) {
    const float t=clamp(x,-4.0,4.0);
#if NR_ALT_U
    const float u=fma(abs(t),-0.055908203125,0.447265625);
#else
    const float u=fma(-0.055908203125,abs(t),0.447265625);
#endif
#if NR_ALT_W
    const float w=fma(u,t,0.89453125);
#else
    const float w=fma(t,u,0.89453125);
#endif
#if NR_ALT_M
    return w*x;
#else
    return x*w;
#endif
}
#if NR_ACT_ALT
#define nr_mp_cubic_silu_b nr_act_horner_b
#else
#define nr_mp_cubic_silu_b nr_act_horner
#endif
#if NR_ACT_PAT
#if defined(NR_ABLATE_ACT) && NR_ABLATE_ACT
// Diagnostic (wrong output): the activation priced by leaving it out.
#define NR_ACTP(x, c)   (x)
#define NR_ACTP_B(x, c) (x)
#else
#define NR_ACTP(x, c)   nr_act_pick(x, c)
#define NR_ACTP_B(x, c) nr_act_pick(x, c)
#endif
#else
#define NR_ACTP(x, c)   nr_mp_cubic_silu(x)
#define NR_ACTP_B(x, c) nr_mp_cubic_silu_b(x)
#endif
// NR_ACT_PAT: which values of a component run take the _b spelling -
// parity of (component index & mask). 0 keeps the pairwise call sites
// (second of each pair). Constant after unrolling, so one call survives.
#ifndef NR_ACT_PAT
#define NR_ACT_PAT 0
#endif
float nr_act_pick(float x, int c) {
    return (bitCount(uint(c) & uint(NR_ACT_PAT)) & 1) != 0 ? nr_act_horner_b(x) : nr_act_horner(x);
}
#endif
// MpCubicSiluActivation, recovered from 1936 call sites.
float nr_act(float x) {
    return nr_swin_act(x);
}

// Adjacent components can use the original packed half FMA sequence directly.
f16vec2 nr_act2(f16vec2 x) {
    return nr_swin_act2(x);
}

#if NR_ACTIVATION_LUT
fe4m3vec2 nr_act_lookup(f16vec2 x) {
    const uint bits=packFloat2x16(x);
    return fe4m3vec2(nr_act_lds[(bits&65535u)>>NR_ACTIVATION_LUT_SHIFT],nr_act_lds[bits>>(16u+NR_ACTIVATION_LUT_SHIFT)]);
}
