// ---- NR_PKN: one-instruction f32 -> f16 pair narrowing --------------------
//
// gfx1201 has no packed round-to-nearest-even narrowing - `v_cvt_pk_f16_f32`
// is gfx1250-only and `llvm-mc -mcpu=gfx1201` rejects it - so building an
// `f16vec2` out of two f32 accumulator components costs **two**
// `v_cvt_f16_f32`, and the whole shader is written around that price. It is
// why NR_NORM_F32 exists: see the long comment at the Q/K norm.
//
// It has a **round-toward-zero** sibling that this part does have:
//
//     v_cvt_pk_rtz_f16_f32 v0, v1, v2   ; encoding: [0x01,0x05,0x00,0x5e]
//
// and on RADV the GLSL spelling `packHalf2x16(vec2(a, b))` with **f32**
// arguments lowers straight to it - one instruction for the pair. Verified in
// the ISA; both `f16vec2(NR_F16(a), NR_F16(b))` and `f16vec2(vec2(a, b))`
// give two `v_cvt_f16_f32_e32 vN.l/.h` where `packHalf2x16` gives one
// `v_cvt_pk_rtz_f16_f32_e32`.
//
// A previous session recorded "packHalf2x16(f16vec2) - ACO folds it" as a dead
// end. That fed it values that were already f16, so nothing was left to
// convert. Feeding it two f32 accumulator components is a different thing.
//
// **RTZ is not NVIDIA's rounding**, and unlike a one-off difference it is a
// systematic bias toward zero, so the sites are classified and switched
// separately rather than globally:
//
//   low          the narrowed value reaches an e4m3 quantisation almost at
//                once. e4m3 has three mantissa bits against f16's ten, so an
//                RTZ/RNE disagreement in the last f16 bit survives to the
//                e4m3 grid only when the value sits within 2^-11 of a
//                midpoint. Q, K, V, P, ctx.
//   exact        the source is an e4m3 value widened to f32. Every e4m3 is
//                exactly representable in f16, so RTZ and RNE agree bit for
//                bit and this class is free. xb.
//   mid          the narrowing feeds packed f16 arithmetic (the SiLU) before
//                the quantisation. eq, yq.
//   reduction    the narrowed value is summed - the Q/K norm's f32 sums and
//                the exp whose result the probability sum accumulates. A
//                downward bias accumulates here; these stay on RNE unless a
//                measurement says otherwise.
//
// Default 0, and the NR_PKN=0 expansion of every macro below is the exact
// token sequence it replaced, so the shipping SPIR-V does not move
// (`cmp`-verified against the previous SPV).
//
// ## What each site is worth, C=32 at the shipping defines
//
// Per 64-token window, one wave. `cycles = (instrs - wmma) + 8 * wmma`; the
// measured column is `us * MHz` from two to three interleaved fswin benchmark
// rows at 8160 windows, quoted in kilocycles because the harness's clock moved
// 2669..2755 MHz inside one session.
//
//   bit  site  instrs  cvt16  pkrtz  cycles  predicted  measured   gold   host
//    -   none    4752    549      0    6544      -          -      94.2%  91.2%
//    1   xb      4706    485     32    6498    -0.70%     -1.1%    94.2%  91.2%
//    8   Q       4715    485     32    6507    -0.57%       -      94.2%  91.2%
//   16   K       4721    485     32    6513    -0.47%       -      94.1%  91.2%
//    2   eq      4622    296    128    6414    -1.99%     -2.3%    92.4%  90.5%
//    4   yq      4776    485     32    6568    +0.37%       -      94.2%  91.2%
//   32   V       4876    549     32    6668    +1.89%       -        -      -
//   64   P       4900    549      0    6692    +2.26%       -        -      -
//  128   ctx     4855    549     32    6647    +1.57%       -        -      -
//  256   norm    4758    549      0    6550    +0.09%       -        -      -
//    9   xb|Q    4688    421     64    6480    -0.98%     -1.2%    94.2%  91.2%
//   25   +K      4642    357     96    6434    -1.68%     -1.9%    94.1%  91.2%
//   27   +eq     4491    103    224    6283    -3.99%     -4.2%    92.2%  90.7%
//
// **V, P and ctx are the surprise and they say something about the shipping
// kernel, not about RTZ.** Those three sites cost +1.6 to +2.3% instead of
// saving, and their `cvt16` column does not move at all: the baseline has *no*
// narrowing there. `nr_quant_pair(f16vec2 v)` widens the pair straight back
// with `vec2(v)`, and ACO deletes an f32 -> f16 -> f32 round trip - the thing
// `nr_round_f16` in coopmm.glsl exists to work around. So **256 of the ~800
// narrowings this source asks for are already gone** (V 64, P 128, ctx 64):
// those three go f32 -> e4m3 in one rounding where NVIDIA's PTX rounds twice.
// Spelling them with `v_cvt_pk_rtz` makes the f16 step real again and then has
// to pay two `v_cvt_f32_f16` to undo it, which is the whole regression.
// Whether restoring NVIDIA's second rounding *there* buys `kernel/gold` is a
// separate question not measured here; it is the one worth asking next.
//
// `xb` and `Q` are byte-identical on the standalone C=32 layer - gold
// 1929/2048, host 1868/2048, the same ulp histogram - so `NR_PKN32=9` ships.
// **They are not byte-identical in the frame**: the 1080p PNG differs from the
// previous build's, because a hundred C=32 layers of real data find the ties one
// standalone layer and one input do not. `xb` alone is exact by construction
// and that half does hold everywhere.
//
// ## The cleaner spelling, which exists and is not usable per site
//
// `spirv_execution_mode(4463, 16)` - SPIR-V's `RoundingModeRTZ` for 16-bit -
// makes ACO pair two ordinary `float16_t(x)` narrowings into one
// `v_cvt_pk_rtz_f16_f32` **with no source change at all**; verified in the ISA.
// It is rejected here only because it is per *entry point*: it would put the
// Q/K norm's sums and the exp on RTZ too, which are the reduction sites this
// classification exists to keep on RNE. It also wants the `RoundingModeRTZ`
// capability and `shaderRoundingModeRTZFloat16`, neither of which this project
// declares or checks.
#define NR_PKN_XB    1
#define NR_PKN_EQ    2
#define NR_PKN_YQ    4
#define NR_PKN_Q     8
#define NR_PKN_K    16
#define NR_PKN_V    32
#define NR_PKN_P    64
#define NR_PKN_CTX 128
#define NR_PKN_NORM 256
// The packed-half Q/K norm's own pair, i.e. the NR_NORM_F32=0 site. Not in
// NR_PKN_ALL: it is dead at NR_NORM_F32=1 and it is what phase 3 re-prices.
#define NR_PKN_NSQ  512
#define NR_PKN_LOW  (NR_PKN_Q | NR_PKN_K | NR_PKN_V | NR_PKN_P | NR_PKN_CTX)
#define NR_PKN_MID  (NR_PKN_XB | NR_PKN_EQ | NR_PKN_YQ)
#define NR_PKN_ALL  (NR_PKN_LOW | NR_PKN_MID | NR_PKN_NORM)
// The shipping set: the three sites whose narrowing is real and whose value
// reaches an e4m3 grid or an exact e4m3 source. See the numbers above.
#define NR_PKN_SHIP (NR_PKN_XB | NR_PKN_Q | NR_PKN_K)
#ifndef NR_PKN
#define NR_PKN 0
#endif
#if NR_PKN && (NR_F16_MMA || !NR_QUANT_PAIRED || !NR_PACKED_SWIN_MATH)
// With an f16 accumulator there is nothing to narrow; the unpaired quantiser
// and the unpacked Swin math spell these sites per component.
#error "NR_PKN prices the shipping packed, paired, f32-accumulator path"
#endif
// One `v_cvt_pk_rtz_f16_f32`. The `unpackFloat2x16` is a bitcast, not an op.
#define NR_RTZ2(x, y)  unpackFloat2x16(packHalf2x16(vec2((x), (y))))

// ---- NR_R2: put NVIDIA's *second* rounding back at V, P and ctx -----------
//
// The ledger above found that those three sites have no narrowing at all in
// the shipping kernel: the `f16vec2` is widened straight back by
// `nr_quant_pair`'s `vec2(v)` and ACO deletes the round trip, so 256 of the
// ~800 narrowings this source asks for never happen and the value goes f32 ->
// e4m3 in **one** rounding where NVIDIA's PTX rounds f32 -> f16 -> e4m3 in two.
// `NR_PKN` could not answer whether that costs agreement, because its spelling
// of the site is round-toward-zero, i.e. a second question on top of the first.
//
// This knob restores the second rounding and nothing else, by rounding **in
// f32** with `nr_round_f16_e4m3` - three integer instructions a component that
// the optimiser cannot delete, and exactly RNE f16 on the reachable domain
// (the result is quantised to e4m3 immediately at all three sites, which is
// the precondition that function's comment states). The bits are NR_PKN's, so
// the two knobs name the same sites; `NR_PKN` wins a site it also selects.
#define NR_RNE2(x, y)  f16vec2(nr_round_f16_e4m3(x), nr_round_f16_e4m3(y))
#ifndef NR_R2
#define NR_R2 0
#endif
#if NR_R2 && (NR_F16_MMA || !NR_QUANT_PAIRED || !NR_PACKED_SWIN_MATH)
#error "NR_R2 prices the shipping packed, paired, f32-accumulator path"
#endif

#if (NR_PKN) & NR_PKN_Q
#define NR_N2_Q(x, y)   NR_RTZ2(x, y)
#else
#define NR_N2_Q(x, y)   NR_ACC2(x, y)
#endif
#if (NR_PKN) & NR_PKN_K
#define NR_N2_K(x, y)   NR_RTZ2(x, y)
#else
#define NR_N2_K(x, y)   NR_ACC2(x, y)
#endif
#if (NR_PKN) & NR_PKN_V
#define NR_N2_V(x, y)   NR_RTZ2(x, y)
#elif (NR_R2) & NR_PKN_V
#define NR_N2_V(x, y)   NR_RNE2(x, y)
#else
#define NR_N2_V(x, y)   NR_ACCP(x, y)
#endif
#if (NR_PKN) & NR_PKN_CTX
#define NR_N2_CTX(x, y) NR_RTZ2(x, y)
#elif (NR_R2) & NR_PKN_CTX
#define NR_N2_CTX(x, y) NR_RNE2(x, y)
#else
#define NR_N2_CTX(x, y) NR_ACCP(x, y)
#endif
#if (NR_PKN) & NR_PKN_P
#define NR_N2_P(x, y)   NR_RTZ2(x, y)
#elif (NR_R2) & NR_PKN_P
#define NR_N2_P(x, y)   NR_RNE2(x, y)
#else
#define NR_N2_P(x, y)   f16vec2(NR_F16(x), NR_F16(y))
#endif
#if (NR_PKN) & NR_PKN_XB
#define NR_N2_XB(x, y)  NR_RTZ2(x, y)
#else
#define NR_N2_XB(x, y)  f16vec2(NR_F16(x),NR_F16(y))
#endif
#if (NR_PKN) & NR_PKN_EQ
#define NR_N2_EQ(x, y)  NR_RTZ2(x, y)
#else
#define NR_N2_EQ(x, y)  f16vec2(NR_F16(x), NR_F16(y))
#endif
#if (NR_PKN) & NR_PKN_NORM
#define NR_N2_NORM(x, y) NR_RTZ2(x, y)
#else
#define NR_N2_NORM(x, y) f16vec2(vec2((x), (y)))
#endif
#if (NR_PKN) & NR_PKN_NSQ
#define NR_N2_NSQ(x, y)  NR_RTZ2(x, y)
#else
#define NR_N2_NSQ(x, y)  f16vec2((x),(y))
#endif

// Experiments (off by default). Mode 1 combines half scales; mode 2 scales in FP32
// before FP8; mode 3 also removes the half norm and its overflow-to-zero.
// Modes 4/5 are the baseline/mode-2 arithmetic with bounded Q/K conversions.
// A weight audit establishes abs(head scale)<20, and normalized Q/K are
// bounded near unity, far below FP8's 448 limit. Do not deploy those two modes
// for another model without checking the scale bound. No model term is removed.
#ifndef NR_QK_SCALE_FAST
#define NR_QK_SCALE_FAST 0
#endif
#if NR_QK_SCALE_FAST
#if NR_ACC_F16 != 0 || !NR_QUANT_PAIRED || NR_ATT_F16
#error "fast Q/K scaling requires FP32 accumulation and paired FP8 attention"
#endif
#if NR_QK_SCALE_FAST >= 3 && !NR_NORM_F32
#error "these Q/K experiments require the FP32 square reduction"
#endif
// NR_QK_SAT: mode 5's products through the saturating convert. The values are
// bounded (|q| <= ~1 * |scale| < 20, far below 448), so the result is the same
// bytes; the point is the MODE register - a bare convert needs FP16_OVFL clear,
// so Q/K interleaved with saturating V/P converts made ACO toggle it.
#ifndef NR_QK_SAT
#define NR_QK_SAT 0
#endif
fe4m3vec2 nr_qscale_fast(vec2 value, float norm, float16_t scale) {
#if NR_QK_SCALE_FAST == 5 && NR_QK_SAT
    return nr_quant_pair32(value * (norm * float(scale)));
#elif NR_QK_SCALE_FAST == 1
    return nr_quant_pair(f16vec2(value) * f16vec2(float16_t(norm) * scale));
#elif NR_QK_SCALE_FAST == 4
    return fe4m3vec2((f16vec2(value) * f16vec2(float16_t(norm))) * f16vec2(scale));
#elif NR_QK_SCALE_FAST == 5
    return fe4m3vec2(value * (norm * float(scale)));
#else
    return nr_quant_pair32(value * (float(norm) * float(scale)));
#endif
}
fe4m3vec2 nr_kscale_fast(vec2 value, float norm) {
#if NR_QK_SCALE_FAST == 5 && NR_QK_SAT
    return nr_quant_pair32(value * norm);
#elif NR_QK_SCALE_FAST == 1
    return nr_quant_pair(f16vec2(value) * f16vec2(norm));
#elif NR_QK_SCALE_FAST == 4
    return fe4m3vec2(f16vec2(value) * f16vec2(float16_t(norm)));
#elif NR_QK_SCALE_FAST == 5
    return fe4m3vec2(value * norm);
#else
    return nr_quant_pair32(value * float(norm));
#endif
}
// Two pairs as one conversion (windows/build/quad_quant_glsl.py passes both calls' arguments):
// element for element the pair functions above.
fe4m3vec4 nr_qscale_fast4(vec2 va, float na, float16_t sa, vec2 vb, float nb, float16_t sb) {
#if NR_QK_SCALE_FAST == 5 && NR_QK_SAT && NR_QUANT_EXPLICIT
    return nr_quant_quad32(va * (na * float(sa)), vb * (nb * float(sb)));
#elif NR_QK_SCALE_FAST == 5 && !NR_QK_SAT
    return NR_CVT4(vec4(va * (na * float(sa)), vb * (nb * float(sb))));
#else
    const fe4m3vec2 p = nr_qscale_fast(va, na, sa), q = nr_qscale_fast(vb, nb, sb);
    return fe4m3vec4(p.x, p.y, q.x, q.y);
#endif
}
fe4m3vec4 nr_kscale_fast4(vec2 va, float na, vec2 vb, float nb) {
#if NR_QK_SCALE_FAST == 5 && NR_QK_SAT && NR_QUANT_EXPLICIT
    return nr_quant_quad32(va * na, vb * nb);
#elif NR_QK_SCALE_FAST == 5 && !NR_QK_SAT
    return NR_CVT4(vec4(va * na, vb * nb));
#else
    const fe4m3vec2 p = nr_kscale_fast(va, na), q = nr_kscale_fast(vb, nb);
    return fe4m3vec4(p.x, p.y, q.x, q.y);
#endif
}
#endif

// Experiment (off by default): use the half reciprocal-square-root instruction directly.
// Preserve the existing half reduction, clamping and overflow-to-zero.
#ifndef NR_HALF_RSQ
#define NR_HALF_RSQ 0
#endif
#if NR_HALF_RSQ
#define nr_norm_rsq(value) inversesqrt(max((value), NR_F16(0.000062)))
#else
#define nr_norm_rsq(value) NR_F16(inversesqrt(float(max((value), NR_F16(0.000062)))))
#endif

// ---- NR_ATT_F16: the two activation x activation products in f16 ----------
//
// `NR_F16_MMA` above puts the **whole** kernel on f16 operands and measured
// 1.5x slower, because all eight e4m3 quantisation points survived it and each
// gained conversions rather than losing them. This is the opposite change and
// must not be confused with it: the *weights* stay e4m3, and only the two
// products whose **both** operands are activations move to f16.
//
//     Q . K^T   the logit product      NR_ATT_F16 & 1
//     P . V     the context product    NR_ATT_F16 & 2
//
// Q, K, P and V are rounded onto the e4m3 grid for one reason: the FP8 WMMA
// takes FP8 operands. Nothing downstream wants them as bytes - K and V are
// staged in LDS purely to be read back as fragments, and Q and P never leave
// registers. So under this define four of the eight quantisation points are
// deleted outright, along with the f16 -> f32 widening each needs to reach
// `v_cvt_pk_fp8_f32` and the MODE-register writes its saturation costs.
//
// **The MMA count does not change.** `v_wmma_f32_16x16x16_fp8_fp8` and
// `v_wmma_f32_16x16x16_f16` are both K=16 on gfx1201 - all twenty cooperative
// matrix configurations this part reports are M=N=K=16, and `llvm-mc
// -mcpu=gfx1201` rejects every 16x16x32 dense spelling. What changes is the
// *rate*: 409 TFLOP/s of FP8 against 206 of f16 on the user's own sweep, i.e.
// the same instruction at twice the cycles. At C=32 the two products are 64 of
// the window's 256 WMMAs.
//
// The accumulator stays f32, so the logit epilogue (bias, exponential, the
// probability sum) and the context epilogue are unchanged instruction for
// instruction, and `ctx` still quantises to e4m3 because the output projection
// it feeds has a weight on the other side.
//
// **The fidelity direction.** Not rounding Q/K/P/V is a deviation from NVIDIA's
// arithmetic in the direction of *higher* precision - e4m3 has 3 mantissa bits
// and f16 has 10 - so `kernel/gold` byte agreement falls even though no value
// is less accurate. That is a cost, because the goal is to be indistinguishable
// from their frame, and it is reported as what it is.
//
// The trap is LDS. K and V stage at two bytes an element instead of one, which
// at C=32 takes the window from 4096 B to 8192 and halves occupancy from 8
// subgroups a SIMD to 4. `NR_K_REGS=1` removes `lds_k` entirely - it is legal
// whenever NR_MF >= NR_JF, i.e. one wave owns the whole window - which leaves
// an f16 `lds_v` at 4096 B, back on the measured knee.
//
// **Measured, and it loses. Default off; do not re-try it.**
//
// Five builds, interleaved twice in one session, the fswin benchmark C=32 at the
// shipping defines (NR_FWAVES=1, NR_NORM_F32=1), 8160 windows a dispatch:
//
//   config                      instrs  VALU  LDS  wv   us    MHz  kernel/gold
//   shipping                      4752  3743 4096   8  147.2  2679    94.2%
//   NR_K_REGS=1 alone             4757  3753 2048   9  146.9  2668    94.2%
//   NR_ATT_F16=1 (Q,K) +K_REGS    4505  3558 2048   8  147.0  2680    93.7%
//   NR_ATT_F16=2 (P,V) +K_REGS    4632  3620 4096   8  150.1  2677    87.0%
//   NR_ATT_F16=3      +K_REGS     4342  3435 4096   8  150.9  2658    87.0%
//
// -410 instructions and -308 VALU a window, at the same 192 VGPRs, the same
// 4096 B of LDS and the same 8 subgroups a SIMD - and **1.6% slower in cycles**.
//
// The reason is the one line of the premise that was wrong. The MMA count does
// not rise by 32: both spellings are K=16, so it does not move at all, and the
// `v_wmma` column is 256 in every build above. What moves is the **rate**, and
// a WMMA throughput benchmark measures it directly - FP8 402.6 TFLOP/s against FP16 201.1,
// exactly 2.00x - which at 128 SIMDs and 8192 FLOP an instruction is **8 issue
// cycles for an FP8 WMMA and 16 for an f16 one**. So the window's cost is
//
//     cycles ~= (instructions - wmma) + 8 * wmma_fp8 + 16 * wmma_f16
//
// and that model reproduces all five rows above to within 0.3%: 6544, 6549,
// 6553, 6680, 6646. The 64 activation x activation MMAs buy +512 cycles for
// -410 instructions. It is close, and it is a loss.
//
// **"Time tracks VALU one for one" is a local calibration, not a law.**
// It held across configurations that kept the WMMA mix fixed. A WMMA is eight
// instructions' worth of issue on this part - 2048 of C=32's ~6544 cycles a
// window, 31% - and any change that moves the matrix mix has to be priced in
// cycles, not in VALU.
//
// The fidelity side, which would have mattered if the time had gone the other
// way: the whole 7.2-point `kernel/gold` drop is **P and V**, not Q and K.
// Leaving Q and K in f16 costs 0.5 points of agreement with NVIDIA and *gains*
// 0.5 against our own f32 reference - it is more accurate and less like them,
// exactly as the trade predicts. Leaving P and V in f16 costs 7.2, which is
// what a 3-mantissa-bit probability grid is worth to the context product.
//
// The NR_ATT_F16=0 SPIR-V is byte-identical; all 64 graph SPVs were checked.
#ifndef NR_ATT_F16
#define NR_ATT_F16 0
#endif
#define NR_ATT_F16_QK ((NR_ATT_F16) & 1)
#define NR_ATT_F16_PV ((NR_ATT_F16) & 2)
#if NR_ATT_F16
#if NR_F16_MMA
#error "NR_ATT_F16 is the FP8-weight kernel; NR_F16_MMA already moves everything"
#endif
#if NR_HWAVES
// The head split stages V in `lds_y`, which is also the middle output and the
// context in e4m3. Widening V there would widen both.
#error "NR_ATT_F16 is the token-split path only (NR_HWAVES=0)"
#endif
// NR_QBATCH_ON is defined further down, after this block; the knob that turns
// it on is not.
#if !NR_QUANT_PAIRED || (defined(NR_QBATCH) && NR_QBATCH) || NR_ACC_F16 != 0
#error "NR_ATT_F16 implements the shipping paired-quantiser path only"
#endif
#endif
#if NR_ATT_F16_QK
#define NR_QK_OPA        NR_FRAG_A16
#define NR_QK_OPB        NR_FRAG_B16
#define NR_QK_STAGE_T    NR_F16
#define NR_QK_STAGE_FRAG NR_FRAG_ACC16
#define NR_QK_QT         f16vec2
#define NR_QK_Q(v)       (v)
#else
#define NR_QK_OPA        NR_OPA
#define NR_QK_OPB        NR_OPB
#define NR_QK_STAGE_T    NR_STAGE_T
#define NR_QK_STAGE_FRAG NR_STAGE_FRAG
#define NR_QK_QT         NR_QPAIR_T
#define NR_QK_Q(v)       NR_QPAIR(v)
#endif
#if NR_ATT_F16_PV
#define NR_PV_OPA        NR_FRAG_A16
#define NR_PV_OPB        NR_FRAG_B16
#define NR_PV_STAGE_T    NR_F16
#define NR_PV_STAGE_FRAG NR_FRAG_ACC16
#define NR_PV_QT         f16vec2
#define NR_PV_Q(v)       (v)
#else
#define NR_PV_OPA        NR_OPA
#define NR_PV_OPB        NR_OPB
#define NR_PV_STAGE_T    NR_STAGE_T
#define NR_PV_STAGE_FRAG NR_STAGE_FRAG
#define NR_PV_QT         NR_QPAIR_T
#define NR_PV_Q(v)       NR_QPAIR(v)
#endif

// ---- NR_ABLATE_QSITE: the per-site quantisation ledger --------------------
//
// **Diagnostic only, wrong output on purpose.** A bitmask over the eight places
// this kernel rounds a value onto the e4m3 grid. Where a bit is set the site
// keeps its conversion but loses its *saturation* - the `isinf` select and the
// MODE-register writes around `v_cvt_pk_fp8_f32` - which is the part of a
// requantisation that can be ablated without changing any operand's type.
//
// The eight sites, with their pairs per 64-token window at C=32:
//
//     xb    32   the window's x, staged for stage 1
//     eq   128   the MLP's hidden activation
//     yq    32   the MLP output plus the residual, staged for QKV
//     Q     32   normalised, head-scaled query
//     K     32   normalised key
//     V     32   value
//     P     64   the normalised probabilities
//     ctx   32   the attention context, staged for the output projection
//
// 384 pairs, and the shipping C=32 kernel issues **exactly 384**
// `v_cvt_pk_fp8_f32`. One packed convert per pair, nothing else in the shader
// produces an e4m3 value, and no site was missed - which is what licenses
// reading the ledger's deltas as per-site costs.
#define NR_QS_XB    1
#define NR_QS_EQ    2
#define NR_QS_YQ    4
#define NR_QS_Q     8
#define NR_QS_K    16
#define NR_QS_V    32
#define NR_QS_P    64
#define NR_QS_CTX 128
#ifndef NR_ABLATE_QSITE
#define NR_ABLATE_QSITE 0
#endif
#if NR_ABLATE_QSITE && (NR_F16_MMA || NR_ATT_F16 || !NR_QUANT_PAIRED)
#error "NR_ABLATE_QSITE prices the paired e4m3 quantiser"
#endif
#if NR_ABLATE_QSITE && NR_HWAVES
// The head split has its own `eqg` and `lds_y` sites, which these macros do not
// cover; an ablation that silently misses a site is worse than none.
#error "NR_ABLATE_QSITE is the token-split path only (NR_HWAVES=0)"
#endif
// One macro a site, spelled by the preprocessor rather than by a `?:` on a
// constant, so an ablated site cannot leave its own instructions behind.
#if (NR_ABLATE_QSITE) & NR_QS_XB
#define NR_QP_XB(v)  nr_quant_pair_bare(v)
#elif NR_XB_QH == 1
// Probe: the Inf select taken on the half pair, then widened.
fe4m3vec2 nr_quant_pair_h(f16vec2 v) {
    const f16vec2 w = mix(v, unpackFloat2x16(0x7E007E00u), isinf(v));
    fe4m3vec2 r;
    saturatedConvertEXT(r, vec2(w));
    return r;
}
#define NR_QP_XB(v)  nr_quant_pair_h(v)
#elif NR_XB_QH == 2
// Probe: the Inf test on the half bits (exponent all ones, mantissa 0).
fe4m3vec2 nr_quant_pair_h(f16vec2 v) {
    vec2 x = vec2(v);
    const uint b = packFloat2x16(v) & 0x7FFF7FFFu;
    const bvec2 inf = bvec2((b & 0xFFFFu) == 0x7C00u, (b >> 16u) == 0x7C00u);
    fe4m3vec2 r;
    saturatedConvertEXT(r, mix(x, vec2(uintBitsToFloat(0x7FC00000u)), inf));
    return r;
}
#define NR_QP_XB(v)  nr_quant_pair_h(v)
#else
#define NR_QP_XB(v)  nr_quant_pair(v)
#endif
#if (NR_ABLATE_QSITE) & NR_QS_EQ
#define NR_QP_EQ(v)  nr_quant_pair_bare(v)
#else
#define NR_QP_EQ(v)  NR_QPAIR(v)
#endif
#if (NR_ABLATE_QSITE) & NR_QS_YQ
#define NR_QP_YQ(v)  nr_quant_pair_bare(v)
#else
#define NR_QP_YQ(v)  NR_QPAIR(v)
#endif
#if (NR_ABLATE_QSITE) & NR_QS_Q
#define NR_QP_Q(v)   nr_quant_pair_bare(v)
#else
#define NR_QP_Q(v)   NR_QK_Q(v)
#endif
#if (NR_ABLATE_QSITE) & NR_QS_K
#define NR_QP_K(v)   nr_quant_pair_bare(v)
#else
#define NR_QP_K(v)   NR_QK_Q(v)
#endif
#if (NR_ABLATE_QSITE) & NR_QS_V
#define NR_QP_V(v)   nr_quant_pair_bare(v)
#else
#define NR_QP_V(v)   NR_PV_Q(v)
#endif
#if (NR_ABLATE_QSITE) & NR_QS_P
#define NR_QP_P(v)   nr_quant_pair_bare(v)
#else
#define NR_QP_P(v)   NR_PV_Q(v)
#endif
#if (NR_ABLATE_QSITE) & NR_QS_CTX
#define NR_QP_CTX(v) nr_quant_pair_bare(v)
#else
#define NR_QP_CTX(v) NR_QPAIR(v)
#endif

// ---- NR_WPF: software prefetch of the weight fragments --------------------
//
// Every weight-fed MMA in this kernel loads its A fragment immediately before
// the product that consumes it: the ISA at C=32 is 76 `buffer_load` in 43 VMEM
// clauses, i.e. load, wait, use, load. Under `NR_WPF >= d` each weight-loading
// loop nest becomes a rotating register pipeline `d` iterations deep: the load
// for flat iteration `i + d` is issued at the top of iteration `i`, before that
// iteration's MMAs and before its epilogue, into one of `d + 1` slots. The
// extra slot is what makes the overlap legal without a copy - iteration `i`'s
// fragment lives in slot `i % (d+1)` and the load being issued targets slot
// `(i + d) % (d+1) == (i - 1) % (d+1)`, which iteration `i - 1` has vacated.
//
// The address of every load, every MMA and every epilogue instruction is the
// one the NR_WPF=0 source spells; only the *issue order* of the loads moves,
// so the arithmetic is identical by construction. Each slot is one A fragment:
// 8 e4m3 bytes a lane, 2 VGPRs.
//
// The flat sequence spans the whole nest, so a prefetch crosses the outer
// loop's epilogue (stage 1's activation and quantisation, stage 2's residual
// and requantisation) - which is where most of the compute a wait could hide
// behind actually is.
//
// **Measured, and it does not pay. Default 0.** The transform does what it
// says - at C=32, frame shape, the ISA's first weight run goes from 18 to 20
// consecutive `buffer_load` and the later runs from 1-4 to 5-12, and
// `s_wait_loadcnt` falls 67 -> 66 / 59 / 58 / 57 at depth 1/2/3/4 - at no cost
// at all: 144 VGPRs, 0 spilled, 10 subgroups a SIMD, 4096 B of LDS, 0 scratch
// and 76 VMEM at every depth, with instructions 2552 / 2561 / 2570 / 2564 /
// 2543. The **time does not move**. Standalone t_c32, 8160 windows, each depth
// paired against its own NR_WPF=0 runs and normalised us*MHz/2700:
//
//   depth        0      1      2      3      4
//   us       150.6  150.4  150.1  150.5  149.9
//   norm     147.7  147.2  146.9  147.0  147.0
//   vs 0        -   1.003x 1.005x 1.005x 1.005x
//
// and t_c64 (2040 windows, where only the contract, QKV and output projection
// are pipelined - the heads>1 expand and middle are a different nest) 102.35
// -> 101.65 normalised, 1.007x.
//
// So the 24-cycle issue interval a wave shows here is **not** exposed weight
// load latency: with ten waves a SIMD the loads another wave issues already
// cover this one's, and moving our own earlier buys 0.5%. The knob is kept
// because it is free and because it settles that question with a number.
//
// Default 0, and the NR_WPF=0 SPIR-V is byte-identical.
#ifndef NR_WPF
#define NR_WPF 0
#endif
#if NR_WPF
#if NR_HWAVES
#error "NR_WPF rewrites the token-split loops; the head-split ones (NR_HWAVES) have their own structure"
#endif
#define NR_WPF_SLOTS (NR_WPF + 1)
// `ADDR` is a macro name taking the flat iteration index; the rescan after
// parameter substitution expands it at the call site.
#define NR_WPF_PRIME(pipe, ntot, ADDR)                                        \
    for (int wpfp_ = 0; wpfp_ < NR_WPF; ++wpfp_)                              \
        if (wpfp_ < (ntot))                                                   \
            NR_LOAD_WA(pipe[wpfp_ % NR_WPF_SLOTS], ADDR(wpfp_), 16u);
#define NR_WPF_STEP(pipe, i, ntot, ADDR)                                      \
    if ((i) + NR_WPF < (ntot))                                                \
        NR_LOAD_WA(pipe[((i) + NR_WPF) % NR_WPF_SLOTS],             \
                  ADDR((i) + NR_WPF), 16u);
#define NR_WPF_AT(pipe, i) pipe[(i) % NR_WPF_SLOTS]
#endif

#if (defined(NR_PACKED_EXPAND) || defined(NR_PACKED_QKV) || NR_PACKED_DENSE) && NR_C >= 64 && !NR_HWAVES
#error "paired weights require the head-split path at C >= 64"
#endif
#if NR_PACKED_DENSE < 0 || NR_PACKED_DENSE > 7
#error "NR_PACKED_DENSE must be a three-bit stage mask"
#endif

#ifndef NR_PBATCH
#define NR_PBATCH 1
#endif
#if NR_PBATCH > 1
// NR_PBATCH: one workgroup runs NR_PBATCH persistent items side by side,
// NR_THREADS invocations each - see the claim below. The idea: the second
// workgroup on a CU runs its items ~2.5x slower than the first (oldest-first
// arbitration) and those items form the C=256 critical chain; two items in one
// 16-wave workgroup share barriers and so cannot drift apart.
// **Measured and rejected** (C=256, 64 workgroups): byte-identical, but a
// pair takes 45.7 us (p50) - 22.9 us an item, exactly one 8-wave workgroup
// alone on a CU. The barriers serialise the halves: the older half waits at
// each one while the younger runs at four waves a SIMD, so the 18% throughput
// the second workgroup adds when free-running is gone. C256 0.822..0.837 ms
// against 0.809..0.831.
layout(local_size_x = NR_THREADS * NR_PBATCH) in;
#else
layout(local_size_x = NR_THREADS) in;
#endif

#if NR_PERSIST
// **The acquire is a decoration, not a barrier.** A persistent workgroup waits
// on a producer flag once per window and then reads that producer's tiles; the
// blunt way to make that read safe is `memoryBarrierBuffer()` after the poll,
// which is a statement about every buffer the shader touches. Declaring the
// activation arena `coherent` says the same thing about this buffer only, and
// the barrier goes away.
//
// Read from the ISA on gfx1201 / Mesa 26.2.2, because the mechanism is not the
// one the textbook describes: RADV emits **no cache-invalidate instruction at
// all** for `memoryBarrierBuffer()` here (`global_inv`, `buffer_gl0_inv`:
// zero, before and after this change). What it does instead is put
// `scope:SCOPE_DEV` on the loads, and the eight `buffer_load_b64` that
// `coopMatLoad` lowers to for the x tiles carry it either way. So the change
// is not "an invalidate removed"; it is the same load bits, reached from the
// buffer's own declaration, with a whole-buffer fence deleted. What that fence
// still costs is a scheduling boundary and a `s_waitcnt` per item.
layout(set = 0, binding = 0, std430) coherent buffer ActE4M3 { NR_E4M3 act_e4m3[]; };
#else
layout(set = 0, binding = 0, std430) NR_COH    buffer ActE4M3 { NR_E4M3 act_e4m3[]; };
#endif
// Windows (LLPC): the same activation bytes as 32-bit words (an e4m3 vector type is still
// loaded a byte per element). LLPC cannot prove the
// alignment of act_e4m3[base + j] and loads it one byte at a time; read through this view
// the eight bytes of a fragment row are two dword loads. Same bytes, same order.
#if NR_PERSIST
layout(set = 0, binding = 0, std430) coherent buffer ActE4M3v { uint act_v4[]; };
#else
layout(set = 0, binding = 0, std430) NR_COH    buffer ActE4M3v { uint act_v4[]; };
#endif
// Byte j (0..7) of the 8-byte run starting at `base`, which is 8-aligned by construction.
#define NR_ACT_B8(base, j) uintBitsToFloate4m3EXT(unpack8(act_v4[(base) / 4u + uint(j) / 4u])[(j) % 4])
// A B fragment of activations through the same view: with the byte-typed (and, in a
// persistent run, coherent) array LLPC lowers the load to single bytes.
#if NR_PERSIST
// In a persistent run the array is coherent and LLPC turns coopMatLoad into one atomic byte
// load per element. Lane l of a ColumnMajor B fragment holds column l%16, k 8*(l/16)..+7 -
// eight contiguous bytes - so two coherent dword loads fill it (the order NR_ATTN_KOFF
// already relies on in attn.comp).
#define NR_LOAD_B_ACT(frag, off, stride) do { \
    const uint nr_la = ((off) + (gl_SubgroupInvocationID % 16u) * (stride) + (gl_SubgroupInvocationID / 16u) * 8u) / 4u; \
    const u8vec4 nr_b0 = unpack8(act_v4[nr_la]), nr_b1 = unpack8(act_v4[nr_la + 1u]); \
    for (int nr_i = 0; nr_i < 4; ++nr_i) { \
        frag[nr_i] = uintBitsToFloate4m3EXT(nr_b0[nr_i]); frag[nr_i + 4] = uintBitsToFloate4m3EXT(nr_b1[nr_i]); } } while (false)
#else
#define NR_LOAD_B_ACT(frag, off, stride) \
    coopMatLoad(frag, act_v4, (off) / 4u, (stride) / 4u, gl_CooperativeMatrixLayoutColumnMajor)
#endif
// Windows (LLPC) NR_WIN_ST8: in a persistent run the arena is coherent and LLPC stores an e4m3
// fragment (or vector) one atomic byte at a time (325 buffer_store_b8 in fswinpds*). The same
// eight bytes a lane through a coherent uvec2 view are one store: an e4m3 Accumulator stored
// ColumnMajor puts lane l's components at column l%16, rows 8*(l/16)..+7, i.e. eight contiguous
// bytes at off + (l%16)*stride + 8*(l/16) (the layout NR_LOAD_B_ACT reads). Same bytes, same order.
#ifndef NR_WIN_ST8
#define NR_WIN_ST8 0
#endif
#if NR_WIN_ST8 && !NR_PERSIST
#error "NR_WIN_ST8: persistent runs only"
#endif
// Windows (LLPC): elements c, c+1 of an e4m3 fragment (c even) as f32, through the four-wide
// conversion of their dword. LLPC turns each scalar e4m3 -> f32 conversion into a byte extract
// and a v_cvt_f32_fp8 (a pair into a byte repack); four in order are two v_cvt_pk_f32_fp8.
// Exact either way. The two calls of a dword share the conversion after unrolling.
vec2 nr_e4f2_pick(vec4 v, int c) { return (c & 2) != 0 ? v.zw : v.xy; }
#define NR_E4F2(frag, c) nr_e4f2_pick(vec4(fe4m3vec4((frag)[(c) & ~3], (frag)[((c) & ~3) + 1], \
    (frag)[((c) & ~3) + 2], (frag)[((c) & ~3) + 3])), (c))
uint nr_e4m3x4_bits(fe4m3vec4 v) {
    return pack32(u8vec4(floate4m3BitsToUintEXT(v.x), floate4m3BitsToUintEXT(v.y),
                         floate4m3BitsToUintEXT(v.z), floate4m3BitsToUintEXT(v.w)));
}
#if NR_WIN_ST8
layout(set = 0, binding = 0, std430) coherent buffer ActE4M3v8 { uvec2 act_v8[]; };
#define NR_STORE_ACT_COL(frag, off, stride) do { \
    const uint nr_sa = ((off) + (gl_SubgroupInvocationID % 16u) * (stride) + (gl_SubgroupInvocationID / 16u) * 8u) / 8u; \
    act_v8[nr_sa] = uvec2(nr_e4m3x4_bits(fe4m3vec4(frag[0], frag[1], frag[2], frag[3])), \
                          nr_e4m3x4_bits(fe4m3vec4(frag[4], frag[5], frag[6], frag[7]))); } while (false)
#else
#define NR_STORE_ACT_COL(frag, off, stride) NR_STORE_ACC_COL(frag, act_e4m3, off, stride)
#endif
layout(set = 0, binding = 1, std430) NR_COH    buffer ActF16  { NR_F16  act_f16[]; };
layout(set = 0, binding = 2, std430) readonly buffer WgtE4M3 { NR_E4M3 wgt_e4m3[]; };
layout(set = 0, binding = 3, std430) readonly buffer WgtF32  { float   wgt_f32[]; };
// Windows (LLPC): an e4m3 fragment filled from one 8-byte word (element i = byte i). In this
// shader LLPC builds a fragment loaded from e4m3 data - coopMatLoad or element by element -
// out of byte shuffles, and one per fragment survives as an identity
// `v_perm_b32 vX, vX, vX, 0x3020104`, which also pulls the load's wait forward. From one
// uvec2 through unpack8 the fragment is the loaded registers (from two separate dwords the
// second is still assembled byte by byte). Same bytes, same order.
#define NR_FRAG_Q(frag, v) { const uvec2 nr_fv = (v); \
    const u8vec4 nr_f0 = unpack8(nr_fv.x), nr_f1 = unpack8(nr_fv.y); \
    for (int nr_z = 0; nr_z < 4; ++nr_z) { \
        (frag)[nr_z] = uintBitsToFloate4m3EXT(nr_f0[nr_z]); \
        (frag)[nr_z + 4] = uintBitsToFloate4m3EXT(nr_f1[nr_z]); } }
#ifndef NR_WLOAD_U32
#define NR_WLOAD_U32 0
#endif
#if NR_WLOAD_U32 && NR_F16_MMA
#error "NR_WLOAD_U32: e4m3 weights only"
#endif
// NR_WLOAD_U32: the RowMajor e4m3 weight fragments (NR_LOAD_WA) through NR_FRAG_Q.
#if NR_WLOAD_U32
// A RowMajor A fragment: lane l holds row l%16, k 8*(l/16)..+7 - eight contiguous bytes at
// off + (l%16)*stride + 8*(l/16) (8-aligned: tile offsets and 16-byte rows). One uvec2 load,
// unpacked in place (NR_FRAG_Q); a coopMatLoad from this view is assembled byte by byte too.
layout(set = 0, binding = 2, std430) readonly buffer WgtE4M3w { uvec2 wgt_w8[]; };
#define NR_LOAD_WA(frag, off, stride) NR_FRAG_Q(frag, wgt_w8[((off) + \
    (gl_SubgroupInvocationID % 16u) * (stride) + (gl_SubgroupInvocationID / 16u) * 8u) / 8u])
#else
#define NR_LOAD_WA(frag, off, stride) NR_LOAD_A(frag, NR_WARENA, off, stride)
#endif
layout(set = 0, binding = 4, std430) readonly buffer WgtF16  { NR_F16  wgt_f16[]; };
// **The same bytes, read 32 bits at a time.** The fused RGB projection's 128
// weights are wave-uniform - the index is a push constant plus an unrolled
// loop constant - so they belong in scalar registers, and a 16-bit SSBO load
// cannot go there: a scalar load wants four-byte alignment. An aliased uint
// view of the same binding can. `unpackFloat2x16` is a reinterpretation of the
// two halves that were going to be read anyway, so no value changes.
layout(set = 0, binding = 4, std430) readonly buffer WgtU32  { uint    wgt_u32[]; };
#ifndef NR_RESIDUAL_HALF
#define NR_RESIDUAL_HALF 0
#endif
#if NR_RESIDUAL_HALF && (!NR_NATIVE_RESIDUAL || !NR_PTX_ACC || NR_ACC_F16 != 0 || NR_F16_MMA)
#error "half residual storage requires the default native residual FP32 path"
#endif
// Optionally retain the residual product in FP32 before FP32 MMA.
// This removes the native half-product rounding; it is an approximation.
// Windows (NR_Q32_STAGE): stage the MLP output and the projection output in f32 instead of an
// f16 array widened again at every use; see yh in include/fswin_body.glsl. Default on (=0: off).
#ifndef NR_Q32_STAGE
#define NR_Q32_STAGE 1
#endif
#ifndef NR_Q32_POOL
#define NR_Q32_POOL 0
#endif
#ifndef NR_RESIDUAL_F32
#define NR_RESIDUAL_F32 0
#endif
#if NR_RESIDUAL_F32 && (!NR_NATIVE_RESIDUAL || !NR_PTX_ACC || NR_ACC_F16 != 0 || NR_F16_MMA || NR_RESIDUAL_HALF || NR_STREAM_MLP || NR_ABLATE_RESID)
#error "FP32 residual experiment requires ordinary FP32 native residuals"
#endif
f16vec2 nr_residual_scale(uint off) {
#if NR_RESIDUAL_HALF
    return unpackFloat2x16(wgt_u32[off>>1u]);
#else
    return f16vec2(wgt_f32[off],wgt_f32[off+1u]);
#endif
}
