// Windows (LLPC) NR_WPAIR_U32: the paired weight records read as 8-byte words. Assigned from
// the fe4m3vec4 view, LLPC builds every A fragment byte by byte (eight shuffles) and leaves one
// identity `v_perm_b32 vX, vX, vX, 0x3020104` a fragment behind; from a uvec2 through unpack8
// the fragment is the loaded registers. Same bytes, same order.
#ifndef NR_WPAIR_U32
#define NR_WPAIR_U32 0
#endif
#if NR_WPAIR_U32
layout(set = 0, binding = 4, std430) readonly buffer WExpandPairU { uvec2 wexpand_u2[]; };
#endif
// NR_WPAIR_MASK: which head-split stages fill their paired weight fragments through the uvec2
// view (bit 1 expand, 2 middle, 4 contract, 8 QKV, 16 V, 32 output projection; the C=32
// weights follow NR_WPAIR_U32). Per stage, because the byte-built fragments cost an identity
// v_perm each while the uvec2 fills can lengthen live ranges past a wave threshold.
#ifndef NR_WPAIR_MASK
#if NR_WPAIR_U32
#define NR_WPAIR_MASK 63
#else
#define NR_WPAIR_MASK 0
#endif
#endif
#if NR_WPAIR_MASK && !NR_WPAIR_U32
#error "NR_WPAIR_MASK needs NR_WPAIR_U32=1 (the uvec2 view)"
#endif
#define NR_WPAIR_FILL_B(frag,q) { \
    const fe4m3vec4 lo=wexpand_pair4[q],hi=wexpand_pair4[(q)+1u]; \
    for(int z=0;z<4;++z){(frag)[z]=lo[z];(frag)[z+4]=hi[z];} }
#define NR_WPAIR_FILL2_B(wf0,wf1,q) { \
    const fe4m3vec4 w0=wexpand_pair4[q],w1=wexpand_pair4[(q)+1u]; \
    const fe4m3vec4 w2=wexpand_pair4[(q)+2u],w3=wexpand_pair4[(q)+3u]; \
    for(int v=0;v<4;++v) { \
        wf0[v]=w0[v]; wf0[v+4]=w1[v]; \
        wf1[v]=w2[v]; wf1[v+4]=w3[v]; \
    } }
#if NR_WPAIR_U32
// q is a dword index and even (records are 8-byte aligned).
#define NR_WPAIR_FILL(frag,q) NR_FRAG_Q(frag, wexpand_u2[(q)/2u])
#define NR_WPAIR_FILL2_U(wf0,wf1,q) NR_WPAIR_FILL(wf0,q) NR_WPAIR_FILL(wf1,(q)+2u)
// Chosen by the preprocessor, one macro a stage bit (the call sites pass the literal).
#define NR_WPAIR_FILL2S(wf0,wf1,q,bit) NR_WPAIR_F2_##bit(wf0,wf1,q)
#if (NR_WPAIR_MASK) & 1
#define NR_WPAIR_F2_1(wf0,wf1,q) NR_WPAIR_FILL2_U(wf0,wf1,q)
#else
#define NR_WPAIR_F2_1(wf0,wf1,q) NR_WPAIR_FILL2_B(wf0,wf1,q)
#endif
#if (NR_WPAIR_MASK) & 2
#define NR_WPAIR_F2_2(wf0,wf1,q) NR_WPAIR_FILL2_U(wf0,wf1,q)
#else
#define NR_WPAIR_F2_2(wf0,wf1,q) NR_WPAIR_FILL2_B(wf0,wf1,q)
#endif
#if (NR_WPAIR_MASK) & 4
#define NR_WPAIR_F2_4(wf0,wf1,q) NR_WPAIR_FILL2_U(wf0,wf1,q)
#else
#define NR_WPAIR_F2_4(wf0,wf1,q) NR_WPAIR_FILL2_B(wf0,wf1,q)
#endif
#if (NR_WPAIR_MASK) & 8
#define NR_WPAIR_F2_8(wf0,wf1,q) NR_WPAIR_FILL2_U(wf0,wf1,q)
#else
#define NR_WPAIR_F2_8(wf0,wf1,q) NR_WPAIR_FILL2_B(wf0,wf1,q)
#endif
#if (NR_WPAIR_MASK) & 16
#define NR_WPAIR_F2_16(wf0,wf1,q) NR_WPAIR_FILL2_U(wf0,wf1,q)
#else
#define NR_WPAIR_F2_16(wf0,wf1,q) NR_WPAIR_FILL2_B(wf0,wf1,q)
#endif
#if (NR_WPAIR_MASK) & 32
#define NR_WPAIR_F2_32(wf0,wf1,q) NR_WPAIR_FILL2_U(wf0,wf1,q)
#else
#define NR_WPAIR_F2_32(wf0,wf1,q) NR_WPAIR_FILL2_B(wf0,wf1,q)
#endif
#else
#define NR_WPAIR_FILL(frag,q) NR_WPAIR_FILL_B(frag,q)
#define NR_WPAIR_FILL2S(wf0,wf1,q,bit) NR_WPAIR_FILL2_B(wf0,wf1,q)
#endif
