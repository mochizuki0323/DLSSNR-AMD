+		case VK_FORMAT_G8_B8R8_2PLANE_420_UNORM: return "VK_FORMAT_G8_B8R8_2PLANE_420_UNORM";
+		default: return "VK_FORMAT_OTHER";
+	}
+}
+
+static std::string DrmFormatToString(uint32_t drmFmt) {
+	char buf[32];
+	char c0 = (char)(drmFmt & 0xff);
+	char c1 = (char)((drmFmt >> 8) & 0xff);
+	char c2 = (char)((drmFmt >> 16) & 0xff);
+	char c3 = (char)((drmFmt >> 24) & 0xff);
+	if (isprint(c0) && isprint(c1) && isprint(c2) && isprint(c3)) {
+		snprintf(buf, sizeof(buf), "0x%08x (%c%c%c%c)", drmFmt, c0, c1, c2, c3);
+	} else {
+		snprintf(buf, sizeof(buf), "0x%08x", drmFmt);
+	}
+	return std::string(buf);
+}
 
